LBL_THERMAL_STATS_TEXT=Thermal runaway faults ever: {faults}  |  Heater on: {hours} h  |  Last fault: {last}
LBL_THERMAL_STATS_NO_RESPONSE=No answer to 0x1AA - lifetime thermal counters need URTC firmware 0.3.3 or newer.
LBL_THERMAL_STATS_NOT_PERSISTED=F-RAM not answering: counters are RAM-only since the last boot.
STATE_THERMAL_FAULT=THERMAL RUNAWAY: {fault}
VAL_NONE=none
LOG_AUTODETECT_ACTIVE_PHASE=Auto-detect: no traffic was heard at any bit rate, so the bus looks idle. Now asking at each rate (this transmits).
QT_EXTRUDER_KEEPALIVE_NOTE=While the heater is held, its 150 ms refresh sends 0 extruder steps, which the firmware reads as a stop order: an extruder move started now is cancelled within 150 ms. Move the extruder with the heater off.
VAL_NOTHING_SENT_YET=(nothing sent yet)
VAL_NOT_QUERIED_YET=(not queried yet)
VAL_NONE_YET=(none yet)
TITLE_RAW_BUS_MONITOR=Raw Bus Monitor
