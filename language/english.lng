BTN_ONLY_CHANGES=Only changes
LOG_STOP_ALL_OUTPUTS=Stop all outputs: every known off command was sent ({failed} failed) and every refresh was stopped.
QT_MONITOR_START=START MONITOR
QT_MONITOR_STOP=STOP MONITOR
SELFTEST_STEP_SOLDER=Soldering iron: safe setpoint (0°C) elicits telemetry
SELFTEST_STEP_DRILL=Drill: safe speed (0) elicits telemetry
SELFTEST_STEP_LASER=Laser: safe power/interlock (0/0) elicits endstop telemetry
SELFTEST_STEP_PRINTER=3D printer: safe nozzle setpoint (0°C) elicits hotend telemetry
SELFTEST_STEP_AOI=AOI: endstop telemetry arrives (no command needed - continuous)
SELFTEST_STEP_VACUUM=Vacuum: ADC telemetry arrives (no command needed - continuous)
SELFTEST_STEP_SCAN_PROBE=Scan probe is event-driven (only sends on physical impact) - cannot verify without triggering it by hand
SELFTEST_MOTION_INFO=This tool has no telemetry to verify - STEP/DIR/EN commands are one-shot with no response by design.
SELFTEST_NO_STEPS=No self-test steps are defined for this tool yet.
SELFTEST_DONE=Done.

