QT_GLOBAL_CONTROLS=COMMANDES GLOBALES
QT_EXPANSION_BOARD=CARTE D'EXTENSION
QT_FRAM_PANEL=F-RAM
QT_EXPORT_SESSION=EXPORTER LA SESSION (JOURNAL AVEC EMPREINTE)
BTN_QUERY_THERMAL_STATS=Compteurs thermiques
LBL_THERMAL_STATS_TEXT=Défauts d'emballement thermique : {faults}  |  Chauffe active : {hours} h  |  Dernier défaut : {last}
LBL_THERMAL_STATS_NO_RESPONSE=Pas de réponse à 0x1AA - les compteurs thermiques nécessitent le firmware URTC 0.3.3 ou plus récent.
LBL_THERMAL_STATS_NOT_PERSISTED=La F-RAM ne répond pas : les compteurs sont uniquement en RAM depuis le dernier démarrage.
STATE_THERMAL_FAULT=EMBALLEMENT THERMIQUE : {fault}
VAL_NONE=aucun
LOG_AUTODETECT_ACTIVE_PHASE=Détection automatique : aucun trafic entendu à aucun débit, le bus semble donc inactif. Interrogation à chaque débit maintenant (cela émet).
QT_EXTRUDER_KEEPALIVE_NOTE=Tant que le chauffage est maintenu, son rafraîchissement de 150 ms envoie 0 pas d'extrudeur, que le firmware lit comme un ordre d'arrêt : un mouvement d'extrudeur lancé maintenant est annulé en 150 ms. Déplacez l'extrudeur chauffage éteint.
VAL_NOTHING_SENT_YET=(rien envoyé pour l'instant)
VAL_NOT_QUERIED_YET=(pas encore interrogé)
VAL_NONE_YET=(aucun pour l'instant)
TITLE_RAW_BUS_MONITOR=Moniteur de bus brut
LBL_BUS_STATS_IDLE=Trames/s : -- | Charge du bus : -- % (approx., {bitrate})
LBL_BUS_STATS=Trames/s : {frames} | Charge du bus : {load}% (approx., {bitrate})
LOG_SELFTEST_TESTING=Test : {tool}
LOG_SELFTEST_ACTIVE_TOOL=La requête d'outil actif (0x110) confirme l'outil détecté
LOG_SELFTEST_VERSION=La requête de version (0x7F8) obtient une réponse
LOG_HW_NOTE_DIFFERENT=(attendu 0x{expected} - autre carte ou banc ?)
MSG_NO_TOOL_FOR_JUMPERS=Aucun outil n'est attribué à cette position des cavaliers (ID brut {tool_id}). Rien à tester ici : placez les cavaliers d'ID de la carte sur un vrai profil d'outil.
TITLE_CONFIRM_PHYSICAL_ACTION_Q=Envoyer cette action physique ?
MSG_CONFIRM_PHYSICAL_ACTION=Ceci transmet une vraie commande qui déclenche ou déplace quelque chose sur l'outil (une impulsion de soudure, une impulsion de pâte ou un sertissage). Vérifiez que la zone de travail est dégagée et que les verrouillages physiques sont actifs.
LBL_FILTER_IDS=Filtre d'ID :
BTN_ONLY_CHANGES=Changements seulement
LOG_STOP_ALL_OUTPUTS=Arrêt de toutes les sorties : toutes les commandes d'arrêt connues ont été envoyées ({failed} en échec) et tous les rafraîchissements ont été arrêtés.
QT_MONITOR_START=DÉMARRER LE MONITEUR
QT_MONITOR_STOP=ARRÊTER LE MONITEUR
SELFTEST_STEP_SOLDER=Fer à souder : une consigne sûre (0 °C) provoque de la télémétrie
SELFTEST_STEP_DRILL=Perceuse : une vitesse sûre (0) provoque de la télémétrie
SELFTEST_STEP_LASER=Laser : une puissance et un verrouillage sûrs (0/0) provoquent la télémétrie de fin de course
SELFTEST_STEP_PRINTER=Imprimante 3D : une consigne sûre de la buse (0 °C) provoque la télémétrie du hotend
SELFTEST_STEP_AOI=AOI : la télémétrie de fin de course arrive (aucune commande nécessaire - continue)
SELFTEST_STEP_VACUUM=Vide : la télémétrie de l'ADC arrive (aucune commande nécessaire - continue)
SELFTEST_STEP_SCAN_PROBE=La sonde de balayage fonctionne par événements (elle n'émet que lors d'un impact physique) : impossible à vérifier sans la déclencher à la main
SELFTEST_MOTION_INFO=Cet outil n'a pas de télémétrie à vérifier : les commandes STEP/DIR/EN sont des envois uniques, sans réponse par conception.
SELFTEST_NO_STEPS=Aucune étape d'autotest n'est encore définie pour cet outil.
SELFTEST_DONE=Terminé.

# Log lines of the Qt Quick deck: QTLOG_<TOKEN> is shown instead of the English token; QTLOGD_ are fixed detail sentences
QTLOG_ACTIVE_TOOL=Outil actif
QTLOG_ALL_OFF_FAILED=Échec de l'extinction générale
QTLOG_ALL_OFF_SENT=Extinction générale envoyée
QTLOG_AOI_BLOCKED=AOI bloqué : mode ou période de stroboscope invalide
QTLOG_AOI_FAILED=Échec de la commande AOI
QTLOG_AOI_SENT=Commande AOI envoyée
QTLOG_AUTODETECT_ACTIVE_PHASE=Détection automatique : le bus est silencieux, interrogation à chaque vitesse
QTLOG_AUTODETECT_FAILED=Échec de la détection automatique
QTLOG_AUTODETECT_FOUND=Débit détecté
QTLOG_AUTODETECT_NEEDS_A_SERIAL_PORT=La détection automatique nécessite un port série
QTLOG_AUTODETECT_NO_RESPONSE=Détection automatique : aucune vitesse n'a obtenu de réponse
QTLOG_AUTODETECT_TRAFFIC=Trafic observé pendant la détection
QTLOG_AUTODETECT_TRYING=Essai du débit
QTLOG_BITRATE_SELECTED=Débit sélectionné
QTLOG_BOARD_VERSION=Version du micrologiciel de la carte
QTLOG_SLAVE_APP_VERSION=Version de l'application de l'esclave
QTLOG_BUS_HEALTH_POLL_FAILED=Échec de l'interrogation de l'état du bus
QTLOG_BUS_HEALTH_WARNING=Avertissement sur l'état du bus
