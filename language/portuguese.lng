BTN_QUERY_THERMAL_STATS=Contadores térmicos
LBL_THERMAL_STATS_TEXT=Falhas de fuga térmica: {faults}  |  Aquecedor ligado: {hours} h  |  Última falha: {last}
LBL_THERMAL_STATS_NO_RESPONSE=Sem resposta a 0x1AA - os contadores térmicos requerem firmware URTC 0.3.3 ou posterior.
LBL_THERMAL_STATS_NOT_PERSISTED=A F-RAM não responde: os contadores estão apenas em RAM desde o último arranque.
STATE_THERMAL_FAULT=FUGA TÉRMICA: {fault}
LOG_WATCHDOG_RESET=O último reinício da placa foi causado pelo seu watchdog de hardware (IWDG): o ciclo principal ficou bloqueado.
VAL_NONE=nenhum
LOG_AUTODETECT_ACTIVE_PHASE=Autodeteção: não se ouviu tráfego a nenhum débito, por isso o barramento parece inativo. Agora pergunta-se a cada débito (isto transmite).
QT_EXTRUDER_KEEPALIVE_NOTE=Enquanto o aquecedor é mantido, o seu refrescamento de 150 ms envia 0 passos de extrusor, que o firmware lê como ordem de paragem: um movimento do extrusor iniciado agora é cancelado em 150 ms. Mova o extrusor com o aquecedor desligado.
VAL_NOTHING_SENT_YET=(ainda nada enviado)
VAL_NOT_QUERIED_YET=(ainda não consultado)
VAL_NONE_YET=(nenhum ainda)
TITLE_RAW_BUS_MONITOR=Monitor de barramento em bruto
LBL_BUS_STATS_IDLE=Tramas/s: -- | Carga do barramento: -- % (aprox., {bitrate})
LBL_BUS_STATS=Tramas/s: {frames} | Carga do barramento: {load}% (aprox., {bitrate})
LOG_SELFTEST_TESTING=A testar: {tool}
LOG_SELFTEST_ACTIVE_TOOL=A consulta da ferramenta ativa (0x110) confirma a ferramenta detetada
LOG_SELFTEST_VERSION=A consulta de versão (0x7F8) obtém resposta
LOG_HW_NOTE_DIFFERENT=(esperado 0x{expected} - outra placa ou bancada?)
MSG_NO_TOOL_FOR_JUMPERS=Nenhuma ferramenta está atribuída a esta posição dos jumpers (ID bruto {tool_id}). Nada para testar aqui: coloque os jumpers de ID da placa num perfil de ferramenta real.
TITLE_CONFIRM_PHYSICAL_ACTION_Q=Enviar esta ação física?
MSG_CONFIRM_PHYSICAL_ACTION=Isto transmite um comando real que aciona ou move algo na ferramenta (um impulso de soldadura, um impulso de pasta ou uma crimpagem). Confirme que a zona de trabalho está livre e que os bloqueios físicos estão ativos.
LBL_FILTER_IDS=Filtro de ID:
BTN_ONLY_CHANGES=Só alterações
LOG_STOP_ALL_OUTPUTS=Parar todas as saídas: foram enviados todos os comandos de desligar conhecidos ({failed} falhados) e todos os refrescamentos foram parados.
QT_MONITOR_START=INICIAR MONITOR
QT_MONITOR_STOP=PARAR MONITOR
SELFTEST_STEP_SOLDER=Ferro de soldar: um valor de referência seguro (0 °C) provoca telemetria
SELFTEST_STEP_DRILL=Berbequim: uma velocidade segura (0) provoca telemetria
SELFTEST_STEP_LASER=Laser: uma potência e um interbloqueio seguros (0/0) provocam telemetria do fim de curso
SELFTEST_STEP_PRINTER=Impressora 3D: um valor de referência seguro do bico (0 °C) provoca telemetria do hotend
SELFTEST_STEP_AOI=AOI: chega a telemetria do fim de curso (não é preciso comando - é contínua)
SELFTEST_STEP_VACUUM=Vácuo: chega a telemetria do ADC (não é preciso comando - é contínua)
SELFTEST_STEP_SCAN_PROBE=A sonda de varrimento funciona por eventos (só envia com um impacto físico): não se pode verificar sem a acionar à mão
SELFTEST_MOTION_INFO=Esta ferramenta não tem telemetria a verificar: os comandos STEP/DIR/EN são de envio único e, por conceção, não têm resposta.
SELFTEST_NO_STEPS=Ainda não há passos de autoteste definidos para esta ferramenta.
SELFTEST_DONE=Concluído.
