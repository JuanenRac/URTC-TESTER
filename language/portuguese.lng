QTLOG_SELFTEST_FAILED=O autoteste falhou
QTLOG_SELFTEST_STARTED=Autoteste iniciado
QTLOG_SESSION_EXPORTED=Sessão exportada
QTLOG_SESSION_EXPORT_FAILED=Falha ao exportar a sessão
QTLOG_SHUTDOWN_OUTPUTS_FAILED=Falha ao desligar as saídas
QTLOG_SPI_RESPONSE=Resposta SPI
QTLOG_TELEMETRY_WATCH_BLOCKED=Vigilância de telemetria bloqueada
QTLOG_TELEMETRY_WATCH_FAILED=A vigilância de telemetria falhou
QTLOG_TELEMETRY_WATCH_STARTED=Vigilância de telemetria iniciada
QTLOG_TELEMETRY_WATCH_STOPPED=Vigilância de telemetria parada
QTLOG_THERMAL_CAPTURE=Captura térmica
QTLOG_THERMAL_CAPTURE_BLOCKED=Captura térmica bloqueada
QTLOG_THERMAL_CAPTURE_FAILED=A captura térmica falhou
QTLOG_THERMAL_STATS=Estatísticas térmicas
QTLOG_TRANSPORT_CONNECTED=Ligado
QTLOG_TRANSPORT_DISCONNECTED=Desligado
QTLOG_WATCHDOG_BLOCKED=Watchdog bloqueado: parâmetros numéricos inválidos
QTLOG_WATCHDOG_FAILED=O watchdog falhou
QTLOG_WATCHDOG_SAFE_OFF_FAILED=Falha no desligar seguro do watchdog
QTLOG_WATCHDOG_STARTED=Watchdog iniciado
QTLOG_WATCHDOG_STOPPED=Watchdog parado
QTLOG_WELD_PULSE_BLOCKED=Impulso de soldadura bloqueado: a duração tem de ser um inteiro dentro do intervalo
QTLOG_WELD_PULSE_FAILED=Falha no impulso de soldadura
QTLOG_WELD_PULSE_SENT=Impulso de soldadura enviado
QTLOGD_GATE_ACTIVE=a identidade do perfil ou o modo de verificação ativa não está confirmado
QTLOGD_GATE_CONNECTION=a identidade do perfil ou a ligação não está confirmada
QTLOGD_HOLDS_BUS=uma leitura em direto ocupa o barramento
QTLOGD_NOT_ACTIVE=sem ligação ou fora do modo de verificação ativa
QTLOGD_STEPS_INT=os passos têm de ser um inteiro
QTLOGD_STEPS_RANGE=passos fora de 1..4294967295
QTLOGD_WATCH_RUNNING=já existe uma vigilância em curso
QTLOGD_DRILL_SPEED=a velocidade tem de ser um inteiro dentro do intervalo
QTLOGD_PRINTER_STEPS=os passos do extrusor e a temperatura têm de ser inteiros dentro do intervalo
QTLOGD_PRINTER_FAN=a potência da ventoinha do hotend tem de ser um inteiro dentro do intervalo
QTLOGD_NO_RESPONSE=sem resposta
