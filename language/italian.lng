# URTC Tester - file di lingua Italiano
# CHIAVE=Valore, una per riga. Le righe che iniziano con # e le righe
# vuote vengono ignorate. Un \n letterale in un valore diventa un vero
# a capo.

STATUS_CONNECT_TO_CHECK=(connetti per verificare)
STATUS_CONNECT_TO_DETECT=(connetti per rilevare)
