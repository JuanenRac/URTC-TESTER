# URTC Tester - ficheiro de idioma Português
# CHAVE=Valor, um por linha. As linhas que começam por # e as linhas
# em branco são ignoradas. Um \n literal dentro de um valor é convertido
# numa quebra de linha real.

LBL_ACTUAL_RPM=RPM real:
LBL_ANALOG_READING=Leitura analógica (ADC de 12 bits):
BTN_AUTO_DETECT=Deteção automática
LBL_CAN_ID_HEX=ID CAN (hex):
BTN_CLEAR=Limpar
BTN_CONNECT=Ligar
TAB_CUSTOM_FRAME=Trama CAN personalizada
LBL_DATA_BYTES_HEX=Bytes de dados (hex, separados por espaço):
BTN_DISCONNECT=Desligar
LBL_ENDSTOP_LIMIT_SWITCH=Fim de curso:
BTN_ERASE_FRAM=Apagar F-RAM...
LBL_EXPANSION_BOARD_TYPE=Tipo de placa de expansão (ver EXPANSION.TXT):
BTN_EXPORT_ASC=Exportar .asc...
BTN_EXPORT_TRC=Exportar .trc...
LBL_HOTEND_FAN_RPM=RPM da ventoinha do hotend:
LBL_HOTEND_TEMPERATURE=Temperatura do hotend:
LBL_IMPACTS_DETECTED_SESSION=Impactos detetados nesta sessão:
LBL_LAST_IMPACT=Último impacto:
LBL_LAYER_FAN_RPM=RPM da ventoinha de camada:
LBL_LIVE_TEMPERATURE=Temperatura em direto:
BTN_STOP_MOTION=PARAR
LOG_TOOL_STOP={tool}: ordem de paragem enviada (0 passos).
LOG_DRILL_STOPPED=Berbequim parado (velocidade 0, travão ativo).
LBL_PART_DETECTED_LM393=Peça detetada (LM393):
BTN_QUERY_DIAG0=Consultar DIAG0
BTN_QUERY_STATE=Consultar estado
BTN_QUERY=Consultar
BTN_REFRESH=Atualizar
LBL_REPEAT_EVERY=Repetir a cada
CHK_RING_ON=Anel ligado
BTN_RUN_SELF_TEST=Executar autoteste...
LBL_SPI_BYTES_TO_SEND=Bytes SPI a enviar (hex, separados por espaço):
TITLE_SCAN_PROBE_TELEMETRY=Sonda de varrimento - apenas telemetria de eventos (0x095)
BTN_SEND_ONCE=Enviar uma vez
BTN_SEND=Enviar
HELP_SENDS_RAW_FRAME=Envia uma trama em bruto - útil para um comando que ainda não tem o seu próprio controlo dedicado aqui, ou para testar algo não documentado (ou ainda não documentado) em CANBUS.TXT. Sem validação além do intervalo de ID e DLC\u22648 - o que é enviado é exatamente o que sai para o barramento.
LBL_STATUS_LED_OVERRIDE=Substituição do LED de estado (R/G/B):
TAB_TOOL_CONTROLS=Controlos da ferramenta - {name}
TITLE_VACUUM_TELEMETRY=Ventosa de vácuo - apenas telemetria (0x145)
LBL_MS_UNIT=ms
MSG_RESTART_NEEDED=Reinicia o URTC Tester para que o novo idioma tenha efeito.
TITLE_EXPORT_FAILED=Falha ao exportar
TITLE_RUN_SELF_TEST_Q=Executar autoteste?
MSG_SELF_TEST_CONFIRM=Isto envia um pequeno número de comandos seguros em repouso (valor pretendido/velocidade/potência todos a 0) para verificar que a placa responde como esperado para a ferramenta detetada - nada aqui aquece, dispara ou roda nada a potência real. Continuar?
OPT_STANDARD=Padrão
OPT_NIGHT=Noite
OPT_STANDBY=Espera
OPT_FORWARD=Avançar
OPT_REVERSE=Recuar
OPT_CLOCKWISE=Horário
OPT_COUNTER_CLOCKWISE=Anti-horário
OPT_OFF=Desligado
OPT_SYNCHRONOUS_STROBE=Estroboscópio síncrono
OPT_FIXED_CONTINUOUS=Fixo contínuo
WARN_NO_CARRIER=AVISO: {interface} reporta sem portadora - é o que o kernel mostra durante uma condição de bus-off do CAN (demasiados erros de transmissão) ou uma ligação igualmente em baixo. Se o adaptador está ligado e cablado a um barramento ativo, experimenta: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=erro de leitura do barramento: {e}
LOG_HANDLER_ERROR=erro de manipulador para 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=erro de callback do sniffer: {e}
LBL_NO_RESPONSE_SHORT=sem resposta
LBL_DIAG0_HIGH=ALTO (ativo - falha/paragem no driver integrado ou de expansão)
LBL_DIAG0_LOW=BAIXO (limpo)
LBL_EMPTY_PARENS=(vazio)
LBL_SPI_NO_RESPONSE=(sem resposta - a placa não executa esta versão de firmware, ou não está ligada)
LBL_NO_RESPONSE_OLDER_FW=Sem resposta (firmware antigo, ou não ligado)
LBL_FRAM_NO_RESPONSE=Sem resposta - a placa não executa esta versão de firmware, ou não está ligada.
LBL_FRAM_NO_VALID_STATE=Não existe estado guardado válido (F-RAM não inicializada, ou ainda nada guardado).
LBL_FRAM_STATE_TEXT=Último guardado em: {tool}\nValor pretendido de temperatura: {temp}°C  |  Velocidade/potência: {speed}  |  Direção/interbloqueio: {dir_or_interlock}  |  Ventoinha: {fan}\nErro crítico ativo no último guardado: {had_error}
LBL_FEEDER_POSITION=Posição do alimentador (passos)
VAL_FEEDER_STEPS={n} passos
BTN_RESET_FEEDER_POSITION=Repor Posição a 0
HELP_FEEDER_POSITION_OPEN_LOOP=Estimativa em malha aberta - este motor não tem encoder, por isso esta é a melhor estimativa da própria placa com base nos passos comandados, não uma medição física. Repõe-na depois de carregar uma bobina nova para voltar a fazer sentido.
LOG_TOOL_MOVE={tool}: mover {direction}, {n} passos.
LOG_TOOL_MOVE_BLOCKED_DIRECTION={tool}: movimento bloqueado - direção desconhecida {direction!r}.

# --- Barra de menu ---
MENU_SAVE_LOGS=Guardar registos...
MENU_README=Readme
MENU_GITHUB=GitHub do URTC
MENU_LICENSE=Licença
MSG_LICENSE_FALLBACK=Esta ferramenta está licenciada sob a Licença Pública Geral GNU v3.0 (GPL-3.0-or-later).\nTexto completo: https://www.gnu.org/licenses/gpl-3.0.html\n\nCopyright (C) 2026 JuanenRac (Electro Hobby 3D)
TITLE_ABOUT=Acerca do URTC Tester
ABOUT_TAGLINE=Ferramenta de ambiente de trabalho de diagnóstico CAN em direto para placas URTC.
ABOUT_DESCRIPTION=Liga-se através do mesmo adaptador USB-CAN que o flasher usa, deteta para qual dos 25 perfis de ferramenta a placa está configurada por jumpers, e mostra apenas os controlos e a telemetria em direto dessa ferramenta.
ABOUT_VERSION=Versão
ABOUT_AUTHOR=Autor
ABOUT_EMAIL=E-mail
ABOUT_LICENSE=Licença
BTN_CLOSE=Fechar

# --- Configuração de ferramenta livre (0x1A2/0x1A3) ---
LBL_FREE_TOOL_CONFIG=Configuração de ferramenta livre (pino de ID 11111)
LBL_FREE_TOOL_JUMPERS_OTHER=Os jumpers de ID leem {value} (não 11111 - este registo não está a ser usado)
LBL_FREE_TOOL_JUMPERS_0X1F=Os jumpers de ID leem 11111 (configuração livre ativa)
LBL_FREE_TOOL_NONE_SELECTED=nenhuma selecionada
LBL_FREE_TOOL_SELECTION=A EEPROM indica: {tool}

# --- Tipo de periférico + número de série (0x1A4/0x1A5) - ver EEPROM.TXT secção 6 ---
LBL_PERIPHERAL_INFO=Tipo de periférico e número de série
LBL_PERIPHERAL_TYPE_URTC=Tipo: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Tipo: desconhecido (0x{value:02X})
LBL_DEVICE_SERIAL=Número de série: {serial}

# MLX9064x sensor variant display (0x1A7, read-only - set via urtc_flasher.py)
LBL_MLX_SENSOR_VARIANT=Variante do sensor MLX9064x (ver CANBUS.TXT):

# 13-tool expansion tester panels (added later - see this project's own audit trail)
LBL_FLYING_PROBE_BASIC=Leitura básica (ADC integrado)
LBL_NO_RESPONSE=Sem resposta
BTN_EXPORT_CSV=Exportar CSV
HELP_NO_HANDLER_CONFORMAL_COATING=O atuador próprio desta ferramenta (eletroválvula de spray) e o seu próprio sensor encontram-se na placa base do próprio robô, fora do alcance desta placa - não existe aqui nenhum manipulador CAN para ela, nada a testar nesta placa.
HELP_NO_HANDLER_PRESSFIT_INSERTER=O atuador próprio desta ferramenta (cilindro linear de inserção por pressão) e o seu próprio sensor encontram-se na placa base do próprio robô, fora do alcance desta placa - não existe aqui nenhum manipulador CAN para ela, nada a testar nesta placa.

# --- Confirmações de ações físicas, modo Apenas Escuta, monitorização da saúde do barramento e repetição automática do Detect ---
LOG_SEND_BLOCKED_LISTEN_ONLY=Envio bloqueado de {can_id} - esta ligação está em modo Apenas Escuta.
WARN_SOCKETCAN_LISTEN_ONLY_SOFT=Foi pedido Apenas Escuta para {interface} - esta aplicação não vai transmitir, mas o verdadeiro modo apenas-escuta por hardware do SocketCAN precisa que a interface seja configurada com 'ip link set {interface} type can listen-only on' antes de a levantar; esta aplicação não consegue configurar isso por si própria.
STATE_CRITICAL_ERROR=ERRO CRÍTICO declarado
STATE_CAN_BUS_ERROR=erro de barramento CAN detetado
STATE_BOARD_NOT_RESPONDING=A placa não responde
MSG_NO_CARRIER_SESSION={interface} perdeu a portadora durante esta sessão - provavelmente uma condição de bus-off
VAL_TRIGGERED=DISPARADO
VAL_ENDSTOP_OPEN=aberto
VAL_PART_PICKED_UP=SIM - peça recolhida
VAL_PART_NOT_DETECTED=não
VAL_ON=ativado
VAL_OFF=desativado
VAL_YES=SIM
VAL_NO=não
QT_TRANSPORT_GATE=PORTA DE TRANSPORTE
QT_TRANSPORT_HELP=Seleciona uma porta série SLCAN ou uma interface SocketCAN do Linux.
QT_SAFETY_MODE=MODO DE SEGURANÇA
QT_LISTEN_ONLY=APENAS ESCUTA (SEM TX CAN)
QT_ACTIVE_CHECKS_ARMED=VERIFICAÇÕES ATIVAS ARMADAS
QT_PASSIVE_HELP=Modo de transporte passivo. Os comandos de sondagem estão bloqueados.
QT_ACTIVE_HELP=A sondagem de identidade transmite apenas as consultas documentadas 0x110 e 0x7F8.
QT_STAGED_LIMIT=Este deck tem cobertura real e confirmada para os comandos dos 25 perfis de ferramenta. Ainda não foi verificado com uma placa real - ver "Known limitations" no README.md.
QT_IDENTITY_CHECKPOINTS=PONTOS DE CONTROLO DE IDENTIDADE E SAÚDE
QT_CHECKPOINTS=1  Ligar ao transporte selecionado\n2  Armar explicitamente as verificações ativas, se necessário\n3  Consultar a ferramenta ativa e a versão da placa\n4  Manter um registo de sessão transparente
QT_PROBE=SONDAR FERRAMENTA ATIVA E VERSÃO
QT_ACTIVE_TOOL=FERRAMENTA ATIVA
QT_ACTIVITY_LOG=REGISTO DE ATIVIDADE
QT_PASSIVE_WINDOW=JANELA PASSIVA DO BARRAMENTO
QT_PASSIVE_WINDOW_HELP=Captura tráfego CAN real durante dois segundos. O modo apenas escuta garante que não é transmitido CAN.
QT_CAPTURE_PASSIVE=CAPTURAR JANELA PASSIVA
QT_NO_PASSIVE_FRAMES=Ainda não foi capturada nenhuma janela passiva.
QT_BUS_LOAD=CARGA DO BARRAMENTO
QT_TOOL_PROFILE=PERFIL DA FERRAMENTA
QT_PROFILE_GUARD=Os controlos nativos só são ativados quando a identidade ativa coincide exatamente com o perfil selecionado e as verificações ativas estão armadas.
QT_MOTION_CONTROL=MOVIMENTO DE DISPARO ÚNICO
QT_DIRECTION=DIREÇÃO
