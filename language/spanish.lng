LBL_STATUS_BUSY=Ocupado (captura en curso)
LBL_STATUS_ERROR=Error (fallo de comunicacion con el sensor)
LBL_STATUS_IDLE=Inactivo
LBL_STATUS_READY=Listo (imagen disponible)
