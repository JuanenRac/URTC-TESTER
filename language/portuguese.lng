LBL_PERIPHERAL_INFO=Tipo de periférico e número de série
LBL_PERIPHERAL_TYPE_URTC=Tipo: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Tipo: desconhecido (0x{value:02X})
LBL_DEVICE_SERIAL=Número de série: {serial}

# MLX9064x sensor variant display (0x1A7, read-only - set via urtc_flasher.py)
LBL_MLX_SENSOR_VARIANT=Variante do sensor MLX9064x (ver CANBUS.TXT):

# 13-tool expansion tester panels (added later - see this project's own audit trail)
LBL_FLYING_PROBE_BASIC=Leitura básica (ADC integrado)
LBL_NO_RESPONSE=Sem resposta
BTN_EXPORT_CSV=Exportar CSV
HELP_NO_HANDLER_CONFORMAL_COATING=O atuador próprio desta ferramenta (eletroválvula de spray) e o seu próprio sensor encontram-se na placa base do próprio robô, fora do alcance desta placa - não existe aqui nenhum manipulador CAN para ela, nada a testar nesta placa.
HELP_NO_HANDLER_PRESSFIT_INSERTER=O atuador próprio desta ferramenta (cilindro linear de inserção por pressão) e o seu próprio sensor encontram-se na placa base do próprio robô, fora do alcance desta placa - não existe aqui nenhum manipulador CAN para ela, nada a testar nesta placa.

# --- Confirmações de ações físicas, modo Apenas Escuta, monitorização da saúde do barramento e repetição automática do Detect ---
LOG_SEND_BLOCKED_LISTEN_ONLY=Envio bloqueado de {can_id} - esta ligação está em modo Apenas Escuta.
WARN_SOCKETCAN_LISTEN_ONLY_SOFT=Foi pedido Apenas Escuta para {interface} - esta aplicação não vai transmitir, mas o verdadeiro modo apenas-escuta por hardware do SocketCAN precisa que a interface seja configurada com 'ip link set {interface} type can listen-only on' antes de a levantar; esta aplicação não consegue configurar isso por si própria.
STATE_CRITICAL_ERROR=ERRO CRÍTICO declarado
STATE_CAN_BUS_ERROR=erro de barramento CAN detetado
STATE_MIXED_BUS_SUSPECTED=O barramento pode misturar velocidades: há uma cabeça de 500 kbit/s e as cabeças mostram erros
STATE_NO_HEAD_AT_ANY_SPEED=Nenhuma cabeça respondeu a nenhuma velocidade: verifique a cablagem, a alimentação e a terminação, ou uma cabeça feita para outra velocidade
STATE_BUS_ERRORS=As cabeças comunicam erros CAN ou um bus-off: verifique a cablagem, a terminação e a velocidade de cada placa
STATE_LEGACY_HEAD_KNOWN=Há uma cabeça de 500 kbit/s neste barramento: recompile todas as placas com a opção herdada ou dê-lhe um barramento próprio
STATE_BOARD_NOT_RESPONDING=A placa não responde
MSG_NO_CARRIER_SESSION={interface} perdeu a portadora durante esta sessão - provavelmente uma condição de bus-off
VAL_TRIGGERED=DISPARADO
VAL_ENDSTOP_OPEN=aberto
VAL_PART_PICKED_UP=SIM - peça recolhida
VAL_PART_NOT_DETECTED=não
VAL_ON=ativado
VAL_OFF=desativado
VAL_YES=SIM
VAL_NO=não
QT_TRANSPORT_GATE=PORTA DE TRANSPORTE
QT_TRANSPORT_HELP=Selecione uma porta série SLCAN ou uma interface SocketCAN do Linux.
QT_SAFETY_MODE=MODO DE SEGURANÇA
QT_LISTEN_ONLY=APENAS ESCUTA (SEM TX CAN)
QT_ACTIVE_CHECKS_ARMED=VERIFICAÇÕES ATIVAS ARMADAS
QT_PASSIVE_HELP=Modo de transporte passivo. Os comandos de sondagem estão bloqueados.
QT_ACTIVE_HELP=A sondagem de identidade transmite apenas as consultas documentadas 0x110 e 0x7F8.
QT_STAGED_LIMIT=Este deck tem cobertura real e confirmada para os comandos dos 25 perfis de ferramenta. Ainda não foi verificado com uma placa real - ver "Known limitations" no README.md.
QT_IDENTITY_CHECKPOINTS=PONTOS DE CONTROLO DE IDENTIDADE E SAÚDE
QT_CHECKPOINTS=1  Ligar ao transporte selecionado\n2  Armar explicitamente as verificações ativas, se necessário\n3  Consultar a ferramenta ativa e a versão da placa\n4  Manter um registo de sessão transparente
QT_PROBE=SONDAR FERRAMENTA ATIVA E VERSÃO
QT_ACTIVE_TOOL=FERRAMENTA ATIVA
QT_ACTIVITY_LOG=REGISTO DE ATIVIDADE
QT_PASSIVE_WINDOW=JANELA PASSIVA DO BARRAMENTO
QT_PASSIVE_WINDOW_HELP=Captura tráfego CAN real durante dois segundos. O modo apenas escuta garante que não é transmitido CAN.
QT_CAPTURE_PASSIVE=CAPTURAR JANELA PASSIVA
QT_NO_PASSIVE_FRAMES=Ainda não foi capturada nenhuma janela passiva.
QT_BUS_LOAD=CARGA DO BARRAMENTO
QT_TOOL_PROFILE=PERFIL DA FERRAMENTA
QT_PROFILE_GUARD=Os controlos nativos só são ativados quando a identidade ativa coincide exatamente com o perfil selecionado e as verificações ativas estão armadas.
QT_MOTION_CONTROL=MOVIMENTO DE DISPARO ÚNICO
QT_DIRECTION=DIREÇÃO
