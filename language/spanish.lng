TITLE_COULDNT_SAVE=No se pudo guardar
MSG_LANGUAGE_NOT_SAVED=La preferencia de idioma no se guardo - comprueba que {path} tenga permisos de escritura.
TITLE_NOT_CONNECTED=No conectado
MSG_CONNECT_FIRST=Conecta al adaptador primero.
TITLE_BAD_INPUT=Entrada incorrecta
TITLE_EXPORT_FAILED=Fallo al exportar
TITLE_NOTHING_SELECTED=Nada seleccionado
MSG_SELECT_PORT_FIRST=Selecciona un puerto/interfaz primero.
TITLE_CONNECTION_FAILED=Fallo de conexion
TITLE_ALREADY_CONNECTED=Ya conectado
MSG_DISCONNECT_FIRST_AUTODETECT=Desconecta primero, luego autodetecta antes de reconectar.
MSG_SELECT_COM_PORT_FIRST=Selecciona un puerto COM primero.
TITLE_NOT_DETECTED=No detectado
MSG_RUN_DETECT_FIRST=Ejecuta Detectar primero, para saber que herramienta probar.
TITLE_NOTHING_TO_EXPORT=Nada que exportar
MSG_TABLE_IS_EMPTY=La tabla esta vacia.
TITLE_NO_CONFIRMATION=Sin confirmacion
MSG_ERASE_NO_RESPONSE=Comando de borrado enviado, pero no llego ninguna respuesta que lo confirme.
TITLE_ERASED=Borrado
MSG_FRAM_ERASED_CONFIRMED=F-RAM borrada y confirmada por la placa.
TITLE_DEBUG_BUNDLE_SAVED=Paquete de depuracion guardado
MSG_SAVED_TO=Guardado en:\n{path}
TITLE_CONNECTION_FAILED_PERMISSION=Fallo de conexion - permiso denegado
MSG_PERMISSION_DENIED_HELP={msg}\n\nEn Linux, los dispositivos serie normalmente necesitan que tu usuario este en el grupo 'dialout':\n\n    sudo usermod -a -G dialout $USER\n\nLuego cierra sesion y vuelve a entrar (los grupos se leen al iniciar sesion) e intentalo de nuevo.
TITLE_PYSERIAL_NOT_INSTALLED=pyserial no esta instalado
MSG_PYSERIAL_NEEDED_AUTODETECT=La autodeteccion necesita pyserial para conexiones serie/SLCAN.\n\nInstalalo con: pip install pyserial
TITLE_RUN_SELF_TEST_Q=¿Ejecutar autoprueba?
MSG_SELF_TEST_CONFIRM=Esto envia un pequeño numero de comandos seguros en reposo (consigna/velocidad/potencia todo a 0) para verificar que la placa responde como se espera para la herramienta detectada - nada aqui calienta, dispara o gira nada a potencia real. ¿Continuar?
TITLE_ERASE_FRAM_Q=¿Borrar F-RAM?
MSG_ERASE_FRAM_CONFIRM=Esto borra permanentemente el estado de parametros guardado en la F-RAM de persistencia de la placa. Esto no se puede deshacer. ¿Continuar?
TITLE_PLAIN_STEPPER_MOTION={tool} - movimiento simple de motor paso a paso (0x120)
OPT_STANDARD=Estandar
OPT_NIGHT=Noche
OPT_STANDBY=Espera
OPT_FORWARD=Adelante
OPT_REVERSE=Reversa
OPT_CLOCKWISE=Horario
OPT_COUNTER_CLOCKWISE=Antihorario
OPT_OFF=Apagado
OPT_SYNCHRONOUS_STROBE=Estrobo sincronizado
OPT_FIXED_CONTINUOUS=Fijo continuo
OPT_RETRACT=Retraer
WARN_NO_CARRIER=AVISO: {interface} reporta sin portadora - esto es lo que el kernel muestra durante una condicion de bus-off de CAN (demasiados errores de transmision) o un enlace igualmente caido. Si el adaptador esta encendido y cableado a un bus activo, prueba: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=error de lectura del bus: {e}
LOG_HANDLER_ERROR=error de manejador para 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=error de callback de sniffer: {e}
LOG_TESTER_READY=URTC Tester listo. HardwareID esperado: 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=Se espera el adaptador en modo SLCAN - consulta el README si tu CANable aparece como algo distinto a un puerto serie.
LOG_EXPECTING_SOCKETCAN_MODE=Modo SocketCAN - se espera que la interfaz ya este activa a 500 kbit/s (ip link set ... up type can bitrate 500000). Consulta la seccion de Linux del README.
LOG_CONNECTED_TO_PORT=Conectado a {port}, canal CAN abierto
LOG_AT_BITRATE_SUFFIX= a {bitrate}.
LOG_DISCONNECTED=Desconectado.
LOG_AUTODETECT_TRYING=Autodeteccion: probando {label}...
LOG_AUTODETECT_RESPONDED=Autodeteccion: la placa respondio a {label}.
LOG_AUTODETECT_NO_RESPONSE=Autodeteccion: sin respuesta a ninguna velocidad de bus estandar - revisa cableado/alimentacion, o la placa podria estar usando una velocidad no estandar que esto no puede probar.
LOG_QUERYING_ACTIVE_TOOL=Consultando herramienta activa (0x110)...
LOG_QUERYING_VERSION=Consultando version (0x7F8)...
LOG_DETECT_FAILED=Deteccion fallida: {e} - la conexion pudo haberse cerrado mientras esto estaba en curso.
LOG_DETECTION_FAILED=Deteccion fallida: sin respuesta a ninguna de las dos consultas.
LOG_ACTIVE_TOOL_STATE=Herramienta activa: {name} (ID {tool_id}). Estado: {state}.
LOG_NO_RESPONSE_0X110_HELP=Sin respuesta a la consulta de herramienta activa (0x110/0x111) - esto necesita firmware compilado con ese soporte; el firmware antiguo no lo respondera.
LOG_VERSION_INFO=Version: {role}, HardwareID 0x{hw_id:08X}{hw_note}, firmware v{major}.{minor}
LOG_OFF_COMMAND_FAILED_ID=No se pudo enviar el comando de apagado 0x{cmd_id:03X} al cambiar de la herramienta {tool_id}: {e}
LOG_OFF_COMMAND_FAILED=No se pudo enviar el comando de apagado al cambiar de la herramienta {tool_id}: {e}
LOG_SENT_GLOBAL_STATUS=Enviado 0x100: RGB de estado=({r1},{g1},{b1}), noche={night}, RGB de anillo=({r2},{g2},{b2}), anillo_encendido={ring_on}
LOG_EXPORTED_FRAMES=Exportadas {n} tramas a {path}
LOG_QUERIED_0X182_NO_RESPONSE=Consultado 0x182 - sin respuesta 0x183.
LOG_EXP_TMC_DIAG0_LEVEL=Nivel TMC_DIAG0: {level}
