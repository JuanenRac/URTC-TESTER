# URTC Tester - ficheiro de idioma Português
# CHAVE=Valor, um por linha. As linhas que começam por # e as linhas
# em branco são ignoradas. Um \n literal dentro de um valor é convertido
# numa quebra de linha real.

LBL_ACTUAL_RPM=RPM real:
LBL_ANALOG_READING=Leitura analógica (ADC de 12 bits):
BTN_AUTO_DETECT=Deteção automática
LBL_CAN_ID_HEX=ID CAN (hex):
BTN_CLEAR=Limpar
BTN_CONNECT=Ligar
TAB_CUSTOM_FRAME=Trama CAN personalizada
