LBL_ENDSTOP_LIMIT_SWITCH=Finecorsa:
BTN_ERASE_FRAM=Cancella F-RAM...
LBL_EXPANSION_BOARD_TYPE=Tipo di scheda di espansione (vedi EXPANSION.TXT):
BTN_EXPORT_ASC=Esporta .asc...
BTN_EXPORT_TRC=Esporta .trc...
LBL_HOTEND_FAN_RPM=RPM ventola hotend:
LBL_HOTEND_TEMPERATURE=Temperatura hotend:
LBL_IMPACTS_DETECTED_SESSION=Impatti rilevati in questa sessione:
LBL_LAST_IMPACT=Ultimo impatto:
LBL_LAYER_FAN_RPM=RPM ventola di strato:
LBL_LIVE_TEMPERATURE=Temperatura in tempo reale:
BTN_STOP_MOTION=STOP
LOG_TOOL_STOP={tool}: comando di arresto inviato (0 passi).
LOG_DRILL_STOPPED=Trapano fermato (velocita 0, freno attivo).
LBL_PART_DETECTED_LM393=Pezzo rilevato (LM393):
BTN_QUERY_DIAG0=Interroga DIAG0
BTN_QUERY_STATE=Interroga stato
BTN_QUERY=Interroga
BTN_REFRESH=Aggiorna
LBL_REPEAT_EVERY=Ripeti ogni
CHK_RING_ON=Anello acceso
BTN_RUN_SELF_TEST=Esegui autotest...
LBL_SPI_BYTES_TO_SEND=Byte SPI da inviare (hex, separati da spazio):
TITLE_SCAN_PROBE_TELEMETRY=Sonda di scansione - solo telemetria eventi (0x095)
BTN_SEND_ONCE=Invia una volta
BTN_SEND=Invia
HELP_SENDS_RAW_FRAME=Invia un frame grezzo - utile per un comando che non ha ancora un proprio controllo dedicato qui, o per testare qualcosa non (ancora) documentato in CANBUS.TXT. Nessuna validazione oltre al range dell'ID e DLC\u22648 - cio che viene inviato e esattamente cio che va sul bus.
LBL_STATUS_LED_OVERRIDE=Override LED di stato (R/G/B):
TAB_TOOL_CONTROLS=Controlli dello strumento - {name}
TITLE_VACUUM_TELEMETRY=Presa a vuoto - solo telemetria (0x145)
LBL_MS_UNIT=ms
MSG_RESTART_NEEDED=Riavvia URTC Tester affinche la nuova lingua abbia effetto.
TITLE_EXPORT_FAILED=Esportazione non riuscita
TITLE_RUN_SELF_TEST_Q=Eseguire l'autotest?
MSG_SELF_TEST_CONFIRM=Questo invia un piccolo numero di comandi sicuri, a riposo (setpoint/velocita/potenza tutti a 0) per verificare che la scheda risponda come previsto per lo strumento rilevato - niente qui scalda, spara o fa girare nulla a potenza significativa. Continuare?
OPT_STANDARD=Standard
OPT_NIGHT=Notte
OPT_STANDBY=Standby
OPT_FORWARD=Avanti
OPT_REVERSE=Indietro
OPT_CLOCKWISE=Orario
OPT_COUNTER_CLOCKWISE=Antiorario
OPT_OFF=Spento
OPT_SYNCHRONOUS_STROBE=Strobo sincrono
OPT_FIXED_CONTINUOUS=Fisso continuo
WARN_NO_CARRIER=ATTENZIONE: {interface} segnala nessuna portante - questo e cio che il kernel mostra durante una condizione di bus-off CAN (troppi errori di trasmissione) o un collegamento altrettanto morto. Se l'adattatore e alimentato e cablato a un bus attivo, prova: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=errore di lettura bus: {e}
LOG_HANDLER_ERROR=errore del gestore per 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=errore callback sniffer: {e}
LBL_NO_RESPONSE_SHORT=nessuna risposta
LBL_DIAG0_HIGH=ALTO (attivo - stallo/errore sul driver integrato o di espansione)
LBL_DIAG0_LOW=BASSO (libero)
LBL_EMPTY_PARENS=(vuoto)
LBL_SPI_NO_RESPONSE=(nessuna risposta - la scheda non esegue questa versione firmware, oppure non e connessa)
LBL_NO_RESPONSE_OLDER_FW=Nessuna risposta (firmware precedente, o non connesso)
LBL_FRAM_NO_RESPONSE=Nessuna risposta - la scheda non esegue questa versione di firmware, o non e connessa.
LBL_FRAM_NO_VALID_STATE=Nessuno stato salvato valido (F-RAM non inizializzata, o niente salvato finora).
LBL_FRAM_STATE_TEXT=Ultimo salvataggio sotto: {tool}\nSetpoint di temperatura: {temp}°C  |  Velocita/potenza: {speed}  |  Direzione/interlock: {dir_or_interlock}  |  Ventola: {fan}\nErrore critico attivo all'ultimo salvataggio: {had_error}
LBL_FEEDER_POSITION=Posizione alimentatore (passi)
VAL_FEEDER_STEPS={n} passi
BTN_RESET_FEEDER_POSITION=Azzera Posizione a 0
HELP_FEEDER_POSITION_OPEN_LOOP=Stima ad anello aperto - questo motore non ha encoder, quindi questa è la migliore stima della scheda basata sui passi comandati, non una misurazione fisica. Azzerala dopo aver caricato una bobina nuova cosicché torni ad avere significato.
LOG_TOOL_MOVE={tool}: movimento {direction}, {n} passi.
LOG_TOOL_MOVE_BLOCKED_DIRECTION={tool}: movimento bloccato - direzione sconosciuta {direction!r}.

