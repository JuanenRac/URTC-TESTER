QTLOG_AUTODETECT_FAILED=Rilevamento automatico non riuscito
QTLOG_AUTODETECT_FOUND=Velocità rilevata
QTLOG_AUTODETECT_NEEDS_A_SERIAL_PORT=Il rilevamento automatico richiede una porta seriale
QTLOG_AUTODETECT_NO_RESPONSE=Rilevamento automatico: nessuna velocità ha ricevuto risposta
QTLOG_AUTODETECT_TRAFFIC=Traffico visto durante il rilevamento
QTLOG_AUTODETECT_TRYING=Prova della velocità
QTLOG_BITRATE_SELECTED=Velocità selezionata
QTLOG_BOARD_VERSION=Versione del firmware della scheda
QTLOG_SLAVE_APP_VERSION=Versione dell'applicazione dello slave
QTLOG_BUS_HEALTH_POLL_FAILED=Interrogazione dello stato del bus non riuscita
