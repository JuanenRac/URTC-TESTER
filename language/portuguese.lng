QTLOG_AUTODETECT_NO_RESPONSE=Deteção automática: nenhuma velocidade obteve resposta
QTLOG_AUTODETECT_TRAFFIC=Tráfego visto durante a deteção
QTLOG_AUTODETECT_TRYING=A tentar a velocidade
QTLOG_BITRATE_SELECTED=Velocidade selecionada
