QT_THERMAL_CAPTURE=CAPTURAR IMAGEM TÉRMICA
QT_NO_THERMAL_FRAME=Ainda não foi capturada nenhuma imagem térmica.
QT_WATCH_TELEMETRY=COMEÇAR A OBSERVAR
