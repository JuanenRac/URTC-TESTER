BTN_QUERY_THERMAL_STATS=Contadores termicos
LBL_THERMAL_STATS_TEXT=Fallos de embalamiento termico: {faults}  |  Calentador encendido: {hours} h  |  Ultimo fallo: {last}
LBL_THERMAL_STATS_NO_RESPONSE=Sin respuesta a 0x1AA - los contadores termicos requieren firmware URTC 0.3.3 o posterior.
LBL_THERMAL_STATS_NOT_PERSISTED=La F-RAM no responde: los contadores solo estan en RAM desde el ultimo arranque.
STATE_THERMAL_FAULT=EMBALAMIENTO TERMICO: {fault}
VAL_NONE=ninguno
LOG_AUTODETECT_ACTIVE_PHASE=Autodeteccion: no se oyo trafico a ninguna velocidad, asi que el bus parece inactivo. Ahora se pregunta a cada velocidad (esto transmite).
QT_EXTRUDER_KEEPALIVE_NOTE=Mientras se mantiene el calefactor, su refresco de 150 ms envia 0 pasos de extrusor, que el firmware lee como orden de parada: un movimiento del extrusor iniciado ahora se cancela en 150 ms. Mueve el extrusor con el calefactor apagado.
VAL_NOTHING_SENT_YET=(nada enviado todavia)
VAL_NOT_QUERIED_YET=(aun sin consultar)
VAL_NONE_YET=(ninguno todavia)
TITLE_RAW_BUS_MONITOR=Monitor de bus en bruto
LBL_BUS_STATS_IDLE=Tramas/s: -- | Carga del bus: -- % (aprox., {bitrate})
LBL_BUS_STATS=Tramas/s: {frames} | Carga del bus: {load}% (aprox., {bitrate})
LOG_SELFTEST_TESTING=Probando: {tool}
LOG_SELFTEST_ACTIVE_TOOL=La consulta de herramienta activa (0x110) confirma la herramienta detectada
LOG_SELFTEST_VERSION=La consulta de version (0x7F8) obtiene respuesta
LOG_HW_NOTE_DIFFERENT=(se esperaba 0x{expected}: ¿otra placa o equipo?)
MSG_NO_TOOL_FOR_JUMPERS=No hay ninguna herramienta asignada a esta posicion de los puentes (ID bruto {tool_id}). Nada que probar aqui: pon los puentes de ID de la placa en un perfil de herramienta real.
TITLE_CONFIRM_PHYSICAL_ACTION_Q=¿Enviar esta accion fisica?
MSG_CONFIRM_PHYSICAL_ACTION=Esto transmite una orden real que dispara o mueve algo en la herramienta (un pulso de soldadura, un pulso de pasta o un crimpado). Comprueba que la zona de trabajo esta despejada y que los enclavamientos fisicos estan activos.
LBL_FILTER_IDS=Filtro de ID:
BTN_ONLY_CHANGES=Solo cambios
LOG_STOP_ALL_OUTPUTS=Parar todas las salidas: se enviaron todas las ordenes de apagado conocidas ({failed} fallidas) y se detuvieron todos los refrescos.
QT_MONITOR_START=INICIAR MONITOR
QT_MONITOR_STOP=DETENER MONITOR
SELFTEST_STEP_SOLDER=Soldador: una consigna segura (0 °C) provoca telemetría
SELFTEST_STEP_DRILL=Taladro: una velocidad segura (0) provoca telemetría
SELFTEST_STEP_LASER=Láser: una potencia e interbloqueo seguros (0/0) provocan telemetría de final de carrera
SELFTEST_STEP_PRINTER=Impresora 3D: una consigna segura de la boquilla (0 °C) provoca telemetría del hotend
SELFTEST_STEP_AOI=AOI: llega la telemetría del final de carrera (no hace falta comando: es continua)
SELFTEST_STEP_VACUUM=Vacío: llega la telemetría del ADC (no hace falta comando: es continua)
SELFTEST_STEP_SCAN_PROBE=La sonda de escaneo funciona por eventos (solo envía al recibir un impacto físico): no se puede verificar sin accionarla a mano
SELFTEST_MOTION_INFO=Esta herramienta no tiene telemetría que verificar: las órdenes STEP/DIR/EN son de un solo envío y no tienen respuesta por diseño.
SELFTEST_NO_STEPS=Todavía no hay pasos de autotest definidos para esta herramienta.
SELFTEST_DONE=Terminado.

# Log lines of the Qt Quick deck: QTLOG_<TOKEN> is shown instead of the English token; QTLOGD_ are fixed detail sentences
QTLOG_ACTIVE_TOOL=Herramienta activa
QTLOG_ALL_OFF_FAILED=Fallo al apagar todo
QTLOG_ALL_OFF_SENT=Apagado general enviado
QTLOG_AOI_BLOCKED=AOI bloqueado: modo o periodo de estroboscopio no válido
