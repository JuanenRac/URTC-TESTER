TITLE_CONNECTION_FAILED=Connessione non riuscita
TITLE_ALREADY_CONNECTED=Gia connesso
MSG_DISCONNECT_FIRST_AUTODETECT=Disconnetti prima, poi esegui il rilevamento automatico prima di riconnettere.
MSG_SELECT_COM_PORT_FIRST=Seleziona prima una porta COM.
TITLE_NOT_DETECTED=Non rilevato
MSG_RUN_DETECT_FIRST=Esegui prima Rileva, cosi si sa quale strumento testare.
TITLE_NOTHING_TO_EXPORT=Niente da esportare
MSG_TABLE_IS_EMPTY=La tabella e vuota.
TITLE_NO_CONFIRMATION=Nessuna conferma
MSG_ERASE_NO_RESPONSE=Comando di cancellazione inviato, ma nessuna risposta e tornata per confermarlo.
TITLE_ERASED=Cancellato
MSG_FRAM_ERASED_CONFIRMED=F-RAM cancellata e confermata dalla scheda.
TITLE_DEBUG_BUNDLE_SAVED=Pacchetto di debug salvato
MSG_SAVED_TO=Salvato in:\n{path}
TITLE_CONNECTION_FAILED_PERMISSION=Connessione non riuscita - permesso negato
MSG_PERMISSION_DENIED_HELP={msg}\n\nSu Linux, i dispositivi seriali di solito richiedono che il tuo utente sia nel gruppo 'dialout':\n\n    sudo usermod -a -G dialout $USER\n\nPoi esci e rientra (l'appartenenza al gruppo viene letta al login) e riprova.
TITLE_PYSERIAL_NOT_INSTALLED=pyserial non installato
MSG_PYSERIAL_NEEDED_AUTODETECT=Il rilevamento automatico richiede pyserial per le connessioni seriali/SLCAN.\n\nInstallalo con: pip install pyserial
TITLE_RUN_SELF_TEST_Q=Eseguire l'autotest?
MSG_SELF_TEST_CONFIRM=Questo invia un piccolo numero di comandi sicuri, a riposo (setpoint/velocita/potenza tutti a 0) per verificare che la scheda risponda come previsto per lo strumento rilevato - niente qui scalda, spara o fa girare nulla a potenza significativa. Continuare?
TITLE_ERASE_FRAM_Q=Cancellare la F-RAM?
MSG_ERASE_FRAM_CONFIRM=Questo cancella permanentemente lo stato dei parametri salvato nella F-RAM di persistenza della scheda. Questa azione non puo essere annullata. Continuare?
TITLE_PLAIN_STEPPER_MOTION={tool} - movimento semplice del motore passo-passo (0x120)
OPT_STANDARD=Standard
OPT_NIGHT=Notte
OPT_STANDBY=Standby
OPT_FORWARD=Avanti
OPT_REVERSE=Indietro
OPT_CLOCKWISE=Orario
OPT_COUNTER_CLOCKWISE=Antiorario
OPT_OFF=Spento
OPT_SYNCHRONOUS_STROBE=Strobo sincronizzato
OPT_FIXED_CONTINUOUS=Fisso continuo
OPT_RETRACT=Retrazione
WARN_NO_CARRIER=ATTENZIONE: {interface} segnala nessuna portante - questo e cio che il kernel mostra durante una condizione di bus-off CAN (troppi errori di trasmissione) o un collegamento altrettanto morto. Se l'adattatore e alimentato e cablato a un bus attivo, prova: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=errore di lettura bus: {e}
LOG_HANDLER_ERROR=errore del gestore per 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=errore callback sniffer: {e}
LOG_TESTER_READY=URTC Tester pronto. HardwareID atteso: 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=Si attende l'adattatore in modalita SLCAN - vedi il README se il tuo CANable appare come qualcosa di diverso da una porta seriale.
LOG_EXPECTING_SOCKETCAN_MODE=Modalita SocketCAN - si attende che l'interfaccia sia gia attiva a 500 kbit/s (ip link set ... up type can bitrate 500000). Vedi la sezione Linux del README.
LOG_CONNECTED_TO_PORT=Connesso a {port}, canale CAN aperto
LOG_AT_BITRATE_SUFFIX= a {bitrate}.
LOG_DISCONNECTED=Disconnesso.
LOG_AUTODETECT_TRYING=Rilevamento automatico: provo {label}...
LOG_AUTODETECT_RESPONDED=Rilevamento automatico: la scheda ha risposto a {label}.
LOG_AUTODETECT_NO_RESPONSE=Rilevamento automatico: nessuna risposta a nessuna velocita bus standard - controlla cablaggio/alimentazione, oppure la scheda potrebbe usare una velocita non standard che questo non puo provare.
LOG_QUERYING_ACTIVE_TOOL=Interrogazione utensile attivo (0x110)...
LOG_QUERYING_VERSION=Interrogazione versione (0x7F8)...
LOG_DETECT_FAILED=Rilevamento fallito: {e} - la connessione potrebbe essersi chiusa durante l'operazione.
LOG_DETECTION_FAILED=Rilevamento fallito: nessuna risposta a entrambe le interrogazioni.
LOG_ACTIVE_TOOL_STATE=Utensile attivo: {name} (ID {tool_id}). Stato: {state}.
LOG_NO_RESPONSE_0X110_HELP=Nessuna risposta all'interrogazione utensile attivo (0x110/0x111) - questo richiede firmware compilato con quel supporto; il firmware piu vecchio non rispondera.
LOG_VERSION_INFO=Versione: {role}, HardwareID 0x{hw_id:08X}{hw_note}, firmware v{major}.{minor}
LOG_OFF_COMMAND_FAILED_ID=Impossibile inviare il comando di spegnimento 0x{cmd_id:03X} passando dall'utensile {tool_id}: {e}
LOG_OFF_COMMAND_FAILED=Impossibile inviare il comando di spegnimento passando dall'utensile {tool_id}: {e}
LOG_SENT_GLOBAL_STATUS=Inviato 0x100: stato RGB=({r1},{g1},{b1}), notte={night}, anello RGB=({r2},{g2},{b2}), anello_acceso={ring_on}
LOG_EXPORTED_FRAMES=Esportati {n} frame in {path}
LOG_QUERIED_0X182_NO_RESPONSE=Interrogato 0x182 - nessuna risposta 0x183.
LOG_EXP_TMC_DIAG0_LEVEL=Livello TMC_DIAG0: {level}
LBL_NO_RESPONSE_SHORT=nessuna risposta
LBL_DIAG0_HIGH=ALTO (attivo - stallo/errore sul driver integrato o di espansione)
LBL_DIAG0_LOW=BASSO (libero)
LBL_EMPTY_PARENS=(vuoto)
LOG_SENT_CUSTOM_FRAME=Frame personalizzato inviato: ID=0x{can_id:03X}, dati={data}
LOG_REPEATING_CUSTOM_FRAME=Ripetizione frame personalizzato ogni {interval}ms: ID=0x{can_id:03X}, dati={data}
LOG_CUSTOM_PERIODIC_SKIPPING=Frame periodico personalizzato: cicli saltati finche il campo non e di nuovo valido ({e})
LOG_CUSTOM_PERIODIC_RESUMING=Frame periodico personalizzato: il campo e di nuovo valido, invii ripresi.
MSG_ENTER_HEX_BYTES_EXAMPLE=Inserisci byte esadecimali separati da spazio, es. 01 02 03
MSG_ENTER_1_TO_7_BYTES=Inserisci tra 1 e 7 byte.
LBL_SPI_NO_RESPONSE=(nessuna risposta - la scheda non esegue questa versione firmware, oppure non e connessa)
LOG_SENT_0X180_NO_RESPONSE=Inviato 0x180 ({tx}) - nessuna risposta 0x181.
LBL_SPI_MALFORMED=(malformato: dichiarati {n} byte, arrivati solo {actual})
LOG_SENT_0X180_MALFORMED=Inviato 0x180 ({tx}) - la risposta 0x181 ha dichiarato {n} byte ma ne sono arrivati solo {actual}: {rx}
LOG_SENT_0X180_RECEIVED=Inviato 0x180 ({tx}), ricevuto in risposta: {rx}
LBL_NO_RESPONSE_OLDER_FW=Nessuna risposta (firmware precedente, o non connesso)
LOG_QUERIED_0X1A1_NO_RESPONSE=Interrogato 0x1A1 - nessuna risposta valida.
LOG_EXPANSION_BOARD_TYPE=Tipo di scheda di espansione: {label}
LBL_FRAM_NO_RESPONSE=Nessuna risposta - la scheda non esegue questa versione di firmware, o non e connessa.
LOG_QUERIED_0X190_NO_RESPONSE=Interrogato 0x190 - nessuna risposta 0x191.
LBL_FRAM_NO_VALID_STATE=Nessuno stato salvato valido (F-RAM non inizializzata, o niente salvato finora).
LOG_FRAM_STATE_NOTHING_SAVED=Stato F-RAM: nessun dato valido salvato.
LBL_FRAM_STATE_TEXT=Ultimo salvataggio sotto: {tool}\nSetpoint di temperatura: {temp}°C  |  Velocita/potenza: {speed}  |  Direzione/interlock: {dir_or_interlock}  |  Ventola: {fan}\nErrore critico attivo all'ultimo salvataggio: {had_error}
LOG_FRAM_STATE_FULL=Stato F-RAM: utensile={tool}, temp={temp}, velocita/potenza={speed}, direzione/interlock={dir_or_interlock}, ventola={fan}, errore_presente={had_error}
LOG_FRAM_ERASE_NO_CONFIRM=Cancellazione F-RAM inviata (0x192) - nessuna risposta di conferma ricevuta.
LOG_FRAM_ERASED_CONFIRMED=F-RAM cancellata e confermata.
LOG_KEEPALIVE_STOPPED=Keepalive '{name}' fermato: {e}
LOG_SOLDER_SETPOINT_ACTIVE=Saldatore: setpoint {temp}°C, invio ogni 150ms (watchdog firmware e 250ms).
LOG_SOLDER_TURNED_OFF=Saldatore: spento (setpoint 0 inviato una volta).
TOOL_SOLDERING_IRON_FEEDER_LABEL=Saldatore - Alimentatore Stagno
LBL_FEEDER_POSITION=Posizione alimentatore (passi)
VAL_FEEDER_STEPS={n} passi
TITLE_RESET_FEEDER_POSITION_Q=Azzerare la posizione dell'alimentatore?
CONFIRM_RESET_FEEDER_POSITION=Questo azzera la posizione tracciata dell'alimentatore di stagno - normalmente si fa subito dopo aver caricato una nuova bobina. Continuare?
LOG_FEEDER_POSITION_RESET=Alimentatore stagno: posizione azzerata a 0.
BTN_RESET_FEEDER_POSITION=Azzera Posizione a 0
HELP_FEEDER_POSITION_OPEN_LOOP=Stima ad anello aperto - questo motore non ha encoder, quindi questa è la migliore stima della scheda basata sui passi comandati, non una misurazione fisica. Azzerala dopo aver caricato una bobina nuova cosicché torni ad avere significato.
LOG_TOOL_MOVE={tool}: movimento {direction}, {n} passi.
LOG_AOI_MODE_PERIOD=AOI: modalita={mode}, periodo={period}
LBL_ARMED=armato
LBL_SAFE=sicuro
LOG_LASER_POWER_INTERLOCK=Laser: potenza {power}, interlock {interlock}, invio ogni 150ms (watchdog firmware e 250ms).
LOG_LASER_STOPPED=Laser: fermato (potenza 0, interlock sicuro inviato una volta).
LOG_SCAN_PROBE_IMPACT=Sonda di scansione: impatto rilevato alle {ts}
LOG_3DP_NOZZLE_SETPOINT_ACTIVE=Ugello stampante 3D: setpoint {temp}°C, invio ogni 150ms (watchdog firmware e 250ms, movimento estrusore non protetto da watchdog).
LOG_3DP_NOZZLE_TURNED_OFF=Ugello stampante 3D: spento (setpoint 0 inviato una volta).
LOG_LAYER_FAN_ACTIVE=Ventola di strato: potenza {power}, invio ogni 400ms (watchdog firmware e 1000ms).
LOG_LAYER_FAN_STOPPED=Ventola di strato: fermata (potenza 0 inviata una volta).
LOG_DEBUG_BUNDLE_EXPORTED=Pacchetto di debug esportato in {path}

