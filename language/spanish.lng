LBL_FREE_TOOL_CONFIG=Configuracion de herramienta libre (ID pin 11111)
LBL_FREE_TOOL_JUMPERS_OTHER=Los jumpers ID leen {value} (no 11111 - este registro no se esta usando)
LBL_FREE_TOOL_JUMPERS_0X1F=Los jumpers ID leen 11111 (configuracion libre activa)
LBL_FREE_TOOL_NONE_SELECTED=ninguna seleccionada
LBL_FREE_TOOL_SELECTION=La EEPROM indica: {tool}

