LBL_EXPANSION_BOARD_TYPE=Tipo de placa de expansão (ver EXPANSION.TXT):
BTN_EXPORT_ASC=Exportar .asc...
BTN_EXPORT_TRC=Exportar .trc...
LBL_HOTEND_FAN_RPM=RPM da ventoinha do hotend:
LBL_HOTEND_TEMPERATURE=Temperatura do hotend:
LBL_IMPACTS_DETECTED_SESSION=Impactos detetados nesta sessão:
LBL_LAST_IMPACT=Último impacto:
LBL_LAYER_FAN_RPM=RPM da ventoinha de camada:
LBL_LIVE_TEMPERATURE=Temperatura em direto:
BTN_STOP_MOTION=PARAR
LOG_TOOL_STOP={tool}: ordem de paragem enviada (0 passos).
LOG_DRILL_STOPPED=Berbequim parado (velocidade 0, travão ativo).
LBL_PART_DETECTED_LM393=Peça detetada (LM393):
BTN_QUERY_DIAG0=Consultar DIAG0
BTN_QUERY_STATE=Consultar estado
BTN_QUERY=Consultar
BTN_REFRESH=Atualizar
LBL_REPEAT_EVERY=Repetir a cada
CHK_RING_ON=Anel ligado
BTN_RUN_SELF_TEST=Executar autoteste...
LBL_SPI_BYTES_TO_SEND=Bytes SPI a enviar (hex, separados por espaço):
TITLE_SCAN_PROBE_TELEMETRY=Sonda de varrimento - apenas telemetria de eventos (0x095)
BTN_SEND_ONCE=Enviar uma vez
BTN_SEND=Enviar
HELP_SENDS_RAW_FRAME=Envia uma trama em bruto - útil para um comando que ainda não tem o seu próprio controlo dedicado aqui, ou para testar algo não documentado (ou ainda não documentado) em CANBUS.TXT. Sem validação além do intervalo de ID e DLC≤8 - o que é enviado é exatamente o que sai para o barramento.
LBL_STATUS_LED_OVERRIDE=Substituição do LED de estado (R/G/B):
TAB_TOOL_CONTROLS=Controlos da ferramenta - {name}
TITLE_VACUUM_TELEMETRY=Ventosa de vácuo - apenas telemetria (0x145)
LBL_MS_UNIT=ms
MSG_RESTART_NEEDED=Reinicie o URTC Tester para que o novo idioma tenha efeito.
TITLE_EXPORT_FAILED=Falha ao exportar
TITLE_RUN_SELF_TEST_Q=Executar autoteste?
MSG_SELF_TEST_CONFIRM=Isto envia um pequeno número de comandos seguros em repouso (valor pretendido/velocidade/potência todos a 0) para verificar que a placa responde como esperado para a ferramenta detetada - nada aqui aquece, dispara ou roda nada a potência real. Continuar?
OPT_STANDARD=Padrão
OPT_NIGHT=Noite
OPT_STANDBY=Espera
OPT_FORWARD=Avançar
OPT_REVERSE=Recuar
OPT_CLOCKWISE=Horário
OPT_COUNTER_CLOCKWISE=Anti-horário
OPT_OFF=Desligado
OPT_SYNCHRONOUS_STROBE=Estroboscópio síncrono
OPT_FIXED_CONTINUOUS=Fixo contínuo
WARN_NO_CARRIER=AVISO: {interface} reporta sem portadora - é o que o kernel mostra durante uma condição de bus-off do CAN (demasiados erros de transmissão) ou uma ligação igualmente em baixo. Se o adaptador está ligado e cablado a um barramento ativo, experimenta: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=erro de leitura do barramento: {e}
LOG_HANDLER_ERROR=erro de manipulador para 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=erro de callback do sniffer: {e}
LBL_NO_RESPONSE_SHORT=sem resposta
LBL_DIAG0_HIGH=ALTO (ativo - falha/paragem no driver integrado ou de expansão)
LBL_DIAG0_LOW=BAIXO (sem alarme)
LBL_EMPTY_PARENS=(vazio)
LBL_SPI_NO_RESPONSE=(sem resposta - a placa não executa esta versão de firmware, ou não está ligada)
LBL_NO_RESPONSE_OLDER_FW=Sem resposta (firmware antigo, ou não ligado)
LBL_FRAM_NO_RESPONSE=Sem resposta - a placa não executa esta versão de firmware, ou não está ligada.
LBL_FRAM_NO_VALID_STATE=Não existe estado guardado válido (F-RAM não inicializada, ou ainda nada guardado).
LBL_FRAM_STATE_TEXT=Último guardado em: {tool}\nValor pretendido de temperatura: {temp}°C  |  Velocidade/potência: {speed}  |  Direção/interbloqueio: {dir_or_interlock}  |  Ventoinha: {fan}\nErro crítico ativo no último guardado: {had_error}
LBL_FEEDER_POSITION=Posição do alimentador (passos)
VAL_FEEDER_STEPS={n} passos
BTN_RESET_FEEDER_POSITION=Repor Posição a 0
HELP_FEEDER_POSITION_OPEN_LOOP=Estimativa em malha aberta - este motor não tem encoder, por isso esta é a melhor estimativa da própria placa com base nos passos comandados, não uma medição física. Reponha-a depois de carregar uma bobina nova para voltar a fazer sentido.
LOG_TOOL_MOVE={tool}: mover {direction}, {n} passos.
LOG_TOOL_MOVE_BLOCKED_DIRECTION={tool}: movimento bloqueado - direção desconhecida {direction!r}.

