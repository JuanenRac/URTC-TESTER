TITLE_COULDNT_SAVE=Échec de l'enregistrement
MSG_LANGUAGE_NOT_SAVED=La préférence de langue n'a pas été enregistrée - vérifiez que {path} est accessible en écriture.
TITLE_NOT_CONNECTED=Non connecté
MSG_CONNECT_FIRST=Connectez d'abord l'adaptateur.
TITLE_BAD_INPUT=Entrée invalide
TITLE_EXPORT_FAILED=Échec de l'exportation
TITLE_NOTHING_SELECTED=Rien de sélectionné
MSG_SELECT_PORT_FIRST=Sélectionnez d'abord un port/interface.
TITLE_CONNECTION_FAILED=Échec de la connexion
TITLE_ALREADY_CONNECTED=Déjà connecté
MSG_DISCONNECT_FIRST_AUTODETECT=Déconnectez d'abord, puis lancez la détection automatique avant de reconnecter.
MSG_SELECT_COM_PORT_FIRST=Sélectionnez d'abord un port COM.
TITLE_NOT_DETECTED=Non détecté
MSG_RUN_DETECT_FIRST=Lancez d'abord Détecter, pour savoir quel outil tester.
TITLE_NOTHING_TO_EXPORT=Rien à exporter
MSG_TABLE_IS_EMPTY=Le tableau est vide.
TITLE_NO_CONFIRMATION=Aucune confirmation
MSG_ERASE_NO_RESPONSE=Commande d'effacement envoyée, mais aucune réponse n'est revenue pour la confirmer.
TITLE_ERASED=Effacé
MSG_FRAM_ERASED_CONFIRMED=F-RAM effacée et confirmée par la carte.
TITLE_DEBUG_BUNDLE_SAVED=Paquet de débogage enregistré
MSG_SAVED_TO=Enregistré dans :\n{path}
TITLE_CONNECTION_FAILED_PERMISSION=Échec de la connexion - permission refusée
MSG_PERMISSION_DENIED_HELP={msg}\n\nSous Linux, les périphériques série ont généralement besoin que votre utilisateur soit dans le groupe 'dialout' :\n\n    sudo usermod -a -G dialout $USER\n\nDéconnectez-vous puis reconnectez-vous (l'appartenance au groupe est lue à la connexion) et réessayez.
TITLE_PYSERIAL_NOT_INSTALLED=pyserial non installé
MSG_PYSERIAL_NEEDED_AUTODETECT=La détection automatique nécessite pyserial pour les connexions série/SLCAN.\n\nInstallez-le avec : pip install pyserial
TITLE_RUN_SELF_TEST_Q=Lancer l'autotest ?
MSG_SELF_TEST_CONFIRM=Ceci envoie un petit nombre de commandes sûres, au repos (consigne/vitesse/puissance toutes à 0) pour vérifier que la carte répond comme attendu pour l'outil détecté - rien ici ne chauffe, ne tire ou ne fait tourner quoi que ce soit à une puissance significative. Continuer ?
TITLE_ERASE_FRAM_Q=Effacer la F-RAM ?
MSG_ERASE_FRAM_CONFIRM=Ceci efface définitivement l'état des paramètres enregistré dans la F-RAM de persistance de la carte. Cette action est irréversible. Continuer ?
TITLE_PLAIN_STEPPER_MOTION={tool} - mouvement simple du moteur pas à pas (0x120)
OPT_STANDARD=Standard
OPT_NIGHT=Nuit
OPT_STANDBY=Veille
OPT_FORWARD=Avant
OPT_REVERSE=Arrière
OPT_CLOCKWISE=Horaire
OPT_COUNTER_CLOCKWISE=Antihoraire
OPT_OFF=Éteint
OPT_SYNCHRONOUS_STROBE=Stroboscope synchronisé
OPT_FIXED_CONTINUOUS=Fixe continu
OPT_RETRACT=Rétraction
WARN_NO_CARRIER=ATTENTION : {interface} signale l'absence de porteuse - c'est ce que le noyau affiche lors d'une condition de bus-off CAN (trop d'erreurs de transmission) ou d'une liaison tout aussi morte. Si l'adaptateur est alimenté et câblé à un bus actif, essayez : sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=erreur de lecture du bus : {e}
LOG_HANDLER_ERROR=erreur de gestionnaire pour 0x{can_id:03X} : {e}
LOG_SNIFFER_ERROR=erreur de rappel sniffer : {e}
LOG_TESTER_READY=URTC Tester prêt. HardwareID attendu : 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=Adaptateur attendu en mode SLCAN - voir le README si votre CANable apparaît comme autre chose qu'un port série.
LOG_EXPECTING_SOCKETCAN_MODE=Mode SocketCAN - interface attendue déjà active à 500 kbit/s (ip link set ... up type can bitrate 500000). Voir la section Linux du README.
LOG_CONNECTED_TO_PORT=Connecté à {port}, canal CAN ouvert
LOG_AT_BITRATE_SUFFIX= à {bitrate}.
LOG_DISCONNECTED=Déconnecté.
LOG_AUTODETECT_TRYING=Détection automatique : essai de {label}...
LOG_AUTODETECT_RESPONDED=Détection automatique : la carte a répondu à {label}.
LOG_AUTODETECT_NO_RESPONSE=Détection automatique : aucune réponse à aucun débit standard - vérifiez câblage/alimentation, ou la carte utilise peut-être un débit non standard que ceci ne peut pas essayer.
LOG_QUERYING_ACTIVE_TOOL=Interrogation de l'outil actif (0x110)...
LOG_QUERYING_VERSION=Interrogation de la version (0x7F8)...
LOG_DETECT_FAILED=Echec de la detection : {e} - la connexion s'est peut-etre fermee pendant l'operation.
LOG_DETECTION_FAILED=Échec de la détection : aucune réponse à aucune des deux interrogations.
LOG_ACTIVE_TOOL_STATE=Outil actif : {name} (ID {tool_id}). État : {state}.
LOG_NO_RESPONSE_0X110_HELP=Aucune réponse à l'interrogation de l'outil actif (0x110/0x111) - ceci nécessite un firmware compilé avec ce support ; un firmware plus ancien n'y répondra pas.
LOG_VERSION_INFO=Version : {role}, HardwareID 0x{hw_id:08X}{hw_note}, firmware v{major}.{minor}
LOG_OFF_COMMAND_FAILED_ID=Impossible d'envoyer la commande d'arrêt 0x{cmd_id:03X} en changeant de l'outil {tool_id} : {e}
LOG_OFF_COMMAND_FAILED=Impossible d'envoyer la commande d'arrêt en changeant de l'outil {tool_id} : {e}
LOG_SENT_GLOBAL_STATUS=Envoyé 0x100 : état RVB=({r1},{g1},{b1}), nuit={night}, anneau RVB=({r2},{g2},{b2}), anneau_allumé={ring_on}
LOG_EXPORTED_FRAMES=Exporté {n} trames vers {path}
LOG_QUERIED_0X182_NO_RESPONSE=Interrogé 0x182 - aucune réponse 0x183.
LOG_EXP_TMC_DIAG0_LEVEL=Niveau TMC_DIAG0 : {level}
LBL_NO_RESPONSE_SHORT=aucune réponse
LBL_DIAG0_HIGH=HAUT (actif - blocage/erreur sur le driver embarqué ou d'extension)
LBL_DIAG0_LOW=BAS (dégagé)
LBL_EMPTY_PARENS=(vide)
LOG_SENT_CUSTOM_FRAME=Trame personnalisée envoyée : ID=0x{can_id:03X}, données={data}
LOG_REPEATING_CUSTOM_FRAME=Répétition de la trame personnalisée toutes les {interval}ms : ID=0x{can_id:03X}, données={data}
LOG_CUSTOM_PERIODIC_SKIPPING=Trame périodique personnalisée : cycles ignorés jusqu'à ce que le champ soit à nouveau valide ({e})
LOG_CUSTOM_PERIODIC_RESUMING=Trame périodique personnalisée : le champ est à nouveau valide, reprise des envois.
MSG_ENTER_HEX_BYTES_EXAMPLE=Entrez des octets hexadécimaux séparés par des espaces, ex. 01 02 03
MSG_ENTER_1_TO_7_BYTES=Entrez entre 1 et 7 octets.
LBL_SPI_NO_RESPONSE=(aucune réponse - la carte n'exécute pas cette version de firmware, ou n'est pas connectée)
LOG_SENT_0X180_NO_RESPONSE=Envoyé 0x180 ({tx}) - aucune réponse 0x181.
LBL_SPI_MALFORMED=(malformé : {n} octets déclarés, seulement {actual} reçus)
LOG_SENT_0X180_MALFORMED=Envoyé 0x180 ({tx}) - la réponse 0x181 a déclaré {n} octets mais seulement {actual} sont réellement arrivés : {rx}
LOG_SENT_0X180_RECEIVED=Envoyé 0x180 ({tx}), reçu en retour : {rx}
LBL_NO_RESPONSE_OLDER_FW=Aucune réponse (firmware plus ancien, ou non connecté)
LOG_QUERIED_0X1A1_NO_RESPONSE=Interrogé 0x1A1 - aucune réponse valide.
LOG_EXPANSION_BOARD_TYPE=Type de carte d'extension : {label}
LBL_FRAM_NO_RESPONSE=Aucune réponse - la carte n'exécute pas cette version de firmware, ou n'est pas connectée.
LOG_QUERIED_0X190_NO_RESPONSE=Interrogé 0x190 - aucune réponse 0x191.
LBL_FRAM_NO_VALID_STATE=Aucun état enregistré valide (F-RAM non initialisée, ou rien enregistré pour l'instant).
LOG_FRAM_STATE_NOTHING_SAVED=État F-RAM : rien de valide enregistré.
LBL_FRAM_STATE_TEXT=Dernier enregistrement sous : {tool}\nConsigne de température : {temp}°C  |  Vitesse/puissance : {speed}  |  Direction/verrouillage : {dir_or_interlock}  |  Ventilateur : {fan}\nErreur critique active au dernier enregistrement : {had_error}
LOG_FRAM_STATE_FULL=État F-RAM : outil={tool}, temp={temp}, vitesse/puissance={speed}, direction/verrouillage={dir_or_interlock}, ventilateur={fan}, erreur_survenue={had_error}
LOG_FRAM_ERASE_NO_CONFIRM=Effacement F-RAM envoyé (0x192) - aucune réponse de confirmation reçue.
LOG_FRAM_ERASED_CONFIRMED=F-RAM effacée et confirmée.
LOG_KEEPALIVE_STOPPED=Maintien '{name}' arrêté : {e}
LOG_SOLDER_SETPOINT_ACTIVE=Fer à souder : consigne {temp}°C, envoi toutes les 150ms (surveillance firmware de 250ms).
LOG_SOLDER_TURNED_OFF=Fer à souder : éteint (consigne 0 envoyée une fois).
TOOL_SOLDERING_IRON_FEEDER_LABEL=Fer à Souder - Alimentateur de Fil
LBL_FEEDER_POSITION=Position de l'alimentateur (pas)
VAL_FEEDER_STEPS={n} pas
TITLE_RESET_FEEDER_POSITION_Q=Réinitialiser la position de l'alimentateur ?
CONFIRM_RESET_FEEDER_POSITION=Ceci réinitialise à 0 la position suivie de l'alimentateur de fil - normalement fait juste après avoir chargé une bobine neuve. Continuer ?
LOG_FEEDER_POSITION_RESET=Alimentateur de fil : position réinitialisée à 0.
BTN_RESET_FEEDER_POSITION=Réinitialiser la Position à 0
HELP_FEEDER_POSITION_OPEN_LOOP=Estimation en boucle ouverte - ce moteur n'a pas d'encodeur, donc c'est la meilleure estimation de cette carte basée sur les pas commandés, pas une mesure physique. Réinitialisez-la après avoir chargé une bobine neuve pour qu'elle redevienne significative.
LOG_TOOL_MOVE={tool} : déplacement {direction}, {n} pas.
LOG_AOI_MODE_PERIOD=AOI : mode={mode}, période={period}
LBL_ARMED=armé
LBL_SAFE=sécurisé
LOG_LASER_POWER_INTERLOCK=Laser : puissance {power}, verrouillage {interlock}, envoi toutes les 150ms (surveillance firmware de 250ms).
LOG_LASER_STOPPED=Laser : arrêté (puissance 0, verrouillage sécurisé envoyé une fois).
LOG_SCAN_PROBE_IMPACT=Sonde de balayage : impact détecté à {ts}
LOG_3DP_NOZZLE_SETPOINT_ACTIVE=Buse imprimante 3D : consigne {temp}°C, envoi toutes les 150ms (surveillance firmware de 250ms, mouvement de l'extrudeuse non surveillé).
LOG_3DP_NOZZLE_TURNED_OFF=Buse imprimante 3D : éteinte (consigne 0 envoyée une fois).
LOG_LAYER_FAN_ACTIVE=Ventilateur de couche : puissance {power}, envoi toutes les 400ms (surveillance firmware de 1000ms).
LOG_LAYER_FAN_STOPPED=Ventilateur de couche : arrêté (puissance 0 envoyée une fois).
LOG_DEBUG_BUNDLE_EXPORTED=Paquet de débogage exporté vers {path}

