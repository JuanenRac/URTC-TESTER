TITLE_SCAN_PROBE_TELEMETRY=Scan Probe - event telemetry only (0x095)
BTN_SEND_ONCE=Send Once
BTN_SEND=Send
HELP_SENDS_RAW_FRAME=Sends a raw frame - useful for a command that doesn't have its own control here yet, or for testing something not (or not yet) documented in CANBUS.TXT. No validation beyond ID range and DLC\u22648 - whatever this sends is exactly what goes on the bus.
LBL_STATUS_LED_OVERRIDE=Status LED override (R/G/B):
TAB_TOOL_CONTROLS=Tool Controls - {name}
TITLE_VACUUM_TELEMETRY=Vacuum Pickup - telemetry only (0x145)
LBL_MS_UNIT=ms
MSG_RESTART_NEEDED=Restart URTC Tester for the new language to take effect.
TITLE_EXPORT_FAILED=Export failed
TITLE_RUN_SELF_TEST_Q=Run self-test?
MSG_SELF_TEST_CONFIRM=This sends a small number of safe, at-rest commands (setpoint/speed/power all 0) to verify the board responds as expected for its detected tool - nothing here heats, fires, or spins anything at meaningful power. Continue?
OPT_STANDARD=Standard
OPT_NIGHT=Night
OPT_STANDBY=Standby
OPT_FORWARD=Forward
OPT_REVERSE=Reverse
OPT_CLOCKWISE=Clockwise
OPT_COUNTER_CLOCKWISE=Counter-clockwise
OPT_OFF=Off
OPT_SYNCHRONOUS_STROBE=Synchronous strobe
OPT_FIXED_CONTINUOUS=Fixed continuous
WARN_NO_CARRIER=WARNING: {interface} reports no carrier - this is what the kernel shows during a CAN bus-off condition (too many transmit errors) or a similarly dead link. If the adapter is powered and wired to a live bus, try: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=bus read error: {e}
LOG_HANDLER_ERROR=handler error for 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=sniffer callback error: {e}
LBL_NO_RESPONSE_SHORT=no response
LBL_DIAG0_HIGH=HIGH (asserted - stall/error on onboard or expansion driver)
LBL_DIAG0_LOW=LOW (clear)
LBL_EMPTY_PARENS=(empty)
LBL_SPI_NO_RESPONSE=(no response - board not running this firmware version, or not connected)
LBL_NO_RESPONSE_OLDER_FW=No response (older firmware, or not connected)
LBL_FRAM_NO_RESPONSE=No response - board not running this firmware version, or not connected.
LBL_FRAM_NO_VALID_STATE=No valid saved state (uninitialized F-RAM, or nothing saved yet).
LBL_FRAM_STATE_TEXT=Last saved under: {tool}\nTemperature setpoint: {temp}°C  |  Speed/power: {speed}  |  Direction/interlock: {dir_or_interlock}  |  Fan: {fan}\nCritical error active at last save: {had_error}
LBL_FEEDER_POSITION=Feeder position (steps)
VAL_FEEDER_STEPS={n} steps
BTN_RESET_FEEDER_POSITION=Reset Position to 0
HELP_FEEDER_POSITION_OPEN_LOOP=Open-loop estimate - this motor has no encoder, so this is this board's own best guess based on commanded steps, not a physical measurement. Reset it after loading a fresh spool so it starts meaning something again.
LOG_TOOL_MOVE={tool}: move {direction}, {n} steps.
LOG_TOOL_MOVE_BLOCKED_DIRECTION={tool}: move blocked - unknown direction {direction!r}.

