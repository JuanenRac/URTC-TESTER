QT_EXPORT_SESSION=ESPORTA SESSIONE (LOG CON HASH)
BTN_QUERY_THERMAL_STATS=Contatori termici
LBL_THERMAL_STATS_TEXT=Guasti da fuga termica: {faults}  |  Riscaldatore acceso: {hours} h  |  Ultimo guasto: {last}
LBL_THERMAL_STATS_NO_RESPONSE=Nessuna risposta a 0x1AA - i contatori termici richiedono il firmware URTC 0.3.3 o successivo.
LBL_THERMAL_STATS_NOT_PERSISTED=La F-RAM non risponde: i contatori sono solo in RAM dall'ultimo avvio.
STATE_THERMAL_FAULT=FUGA TERMICA: {fault}
VAL_NONE=nessuno
LOG_AUTODETECT_ACTIVE_PHASE=Rilevamento automatico: nessun traffico sentito a nessuna velocita, quindi il bus sembra inattivo. Ora si interroga a ogni velocita (questo trasmette).
QT_EXTRUDER_KEEPALIVE_NOTE=Finche il riscaldatore e mantenuto, il suo refresh di 150 ms invia 0 passi di estrusore, che il firmware legge come ordine di arresto: un movimento dell'estrusore avviato ora viene annullato entro 150 ms. Muovi l'estrusore con il riscaldatore spento.
VAL_NOTHING_SENT_YET=(ancora nulla inviato)
VAL_NOT_QUERIED_YET=(non ancora interrogato)
VAL_NONE_YET=(nessuno finora)
TITLE_RAW_BUS_MONITOR=Monitor del bus grezzo
LBL_BUS_STATS_IDLE=Frame/s: -- | Carico del bus: -- % (appross., {bitrate})
LBL_BUS_STATS=Frame/s: {frames} | Carico del bus: {load}% (appross., {bitrate})
LOG_SELFTEST_TESTING=Test: {tool}
LOG_SELFTEST_ACTIVE_TOOL=La richiesta dello strumento attivo (0x110) conferma lo strumento rilevato
LOG_SELFTEST_VERSION=La richiesta di versione (0x7F8) ottiene una risposta
LOG_HW_NOTE_DIFFERENT=(atteso 0x{expected} - altra scheda o banco?)
MSG_NO_TOOL_FOR_JUMPERS=Nessuno strumento e assegnato a questa posizione dei jumper (ID grezzo {tool_id}). Niente da testare qui: imposta i jumper ID della scheda su un profilo strumento reale.
TITLE_CONFIRM_PHYSICAL_ACTION_Q=Inviare questa azione fisica?
MSG_CONFIRM_PHYSICAL_ACTION=Questo trasmette un comando reale che aziona o muove qualcosa sullo strumento (un impulso di saldatura, un impulso di pasta o una crimpatura). Verifica che l'area di lavoro sia libera e che gli interblocchi fisici siano attivi.
LBL_FILTER_IDS=Filtro ID:
BTN_ONLY_CHANGES=Solo variazioni
LOG_STOP_ALL_OUTPUTS=Ferma tutte le uscite: tutti i comandi di spegnimento noti sono stati inviati ({failed} falliti) e tutti i refresh sono stati fermati.
QT_MONITOR_START=AVVIA MONITOR
QT_MONITOR_STOP=FERMA MONITOR
SELFTEST_STEP_SOLDER=Saldatore: un setpoint sicuro (0 °C) genera telemetria
SELFTEST_STEP_DRILL=Trapano: una velocità sicura (0) genera telemetria
SELFTEST_STEP_LASER=Laser: potenza e interblocco sicuri (0/0) generano la telemetria del finecorsa
SELFTEST_STEP_PRINTER=Stampante 3D: un setpoint sicuro dell'ugello (0 °C) genera la telemetria dell'hotend
SELFTEST_STEP_AOI=AOI: arriva la telemetria del finecorsa (nessun comando necessario - continua)
SELFTEST_STEP_VACUUM=Vuoto: arriva la telemetria dell'ADC (nessun comando necessario - continua)
SELFTEST_STEP_SCAN_PROBE=La sonda di scansione funziona a eventi (invia solo all'impatto fisico): non verificabile senza attivarla a mano
SELFTEST_MOTION_INFO=Questo strumento non ha telemetria da verificare: i comandi STEP/DIR/EN sono singoli e senza risposta per progetto.
SELFTEST_NO_STEPS=Per questo strumento non sono ancora definiti passi di autotest.
SELFTEST_DONE=Fatto.

# Log lines of the Qt Quick deck: QTLOG_<TOKEN> is shown instead of the English token; QTLOGD_ are fixed detail sentences
QTLOG_ACTIVE_TOOL=Strumento attivo
QTLOG_ALL_OFF_FAILED=Spegnimento generale non riuscito
QTLOG_ALL_OFF_SENT=Spegnimento generale inviato
QTLOG_AOI_BLOCKED=AOI bloccato: modalità o periodo dello stroboscopio non validi
QTLOG_AOI_FAILED=Comando AOI non riuscito
QTLOG_AOI_SENT=Comando AOI inviato
