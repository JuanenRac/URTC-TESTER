QT_PROFILE_NOT_MATCHED=Selecione e verifique primeiro um perfil de movimento correspondente.
QT_CONFIRM_MOTION=CONFIRMAR MOVIMENTO
QT_CONFIRM_MOTION_HELP=Isto envia um comando CAN de movimento real à ferramenta verificada. Confirme que a máquina está desimpedida e que o seu interbloqueio de segurança está ativo.
QT_CONFIRM=CONFIRMAR
QT_CANCEL=CANCELAR
QT_ADVANCED_CONTROL=CONTROLO AVANÇADO DO PERFIL
QT_DRILL_SPEED=VELOCIDADE DO BERBEQUIM (0-255)
