LBL_PERIPHERAL_TYPE_URTC=Tipo: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Tipo: desconocido (0x{value:02X})
LBL_DEVICE_SERIAL=Numero de serie: {serial}

