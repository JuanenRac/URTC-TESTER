LBL_ENERGIZED=energizado
LBL_FLYING_PROBE_ADVANCED=Lectura avanzada (ADS1115, tarjeta de expansion)
LBL_FLYING_PROBE_BASIC=Lectura basica (ADC integrado)
LBL_FREQUENCY_HZ=Frecuencia (Hz):
