# URTC Tester - archivo de idioma Español
# CLAVE=Valor, uno por linea. Las lineas que empiezan por # y las lineas
# en blanco se ignoran. Un \n literal dentro de un valor se convierte en
# un salto de linea real.

STATUS_CONNECT_TO_CHECK=(conecta para comprobar)
STATUS_CONNECT_TO_DETECT=(conecta para detectar)
