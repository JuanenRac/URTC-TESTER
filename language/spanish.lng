LBL_DIAG0_LOW=BAJO (despejado)
LBL_EMPTY_PARENS=(vacio)
LOG_SENT_CUSTOM_FRAME=Trama personalizada enviada: ID=0x{can_id:03X}, datos={data}
LOG_REPEATING_CUSTOM_FRAME=Repitiendo trama personalizada cada {interval}ms: ID=0x{can_id:03X}, datos={data}
LOG_CUSTOM_PERIODIC_SKIPPING=Trama periodica personalizada: saltando ciclos hasta que el campo sea valido de nuevo ({e})
LOG_CUSTOM_PERIODIC_RESUMING=Trama periodica personalizada: el campo vuelve a ser valido, reanudando envios.
MSG_ENTER_HEX_BYTES_EXAMPLE=Introduce bytes hexadecimales separados por espacio, ej. 01 02 03
MSG_ENTER_1_TO_7_BYTES=Introduce entre 1 y 7 bytes.
LBL_SPI_NO_RESPONSE=(sin respuesta - la placa no ejecuta esta version de firmware, o no esta conectada)
LOG_SENT_0X180_NO_RESPONSE=Enviado 0x180 ({tx}) - sin respuesta 0x181.
LBL_SPI_MALFORMED=(mal formado: declaro {n} bytes, pero solo llegaron {actual})
LOG_SENT_0X180_MALFORMED=Enviado 0x180 ({tx}) - la respuesta 0x181 declaro {n} bytes pero solo llegaron {actual}: {rx}
LOG_SENT_0X180_RECEIVED=Enviado 0x180 ({tx}), recibido de vuelta: {rx}
LBL_NO_RESPONSE_OLDER_FW=Sin respuesta (firmware antiguo, o no conectado)
LOG_QUERIED_0X1A1_NO_RESPONSE=Consultado 0x1A1 - sin respuesta valida.
LOG_EXPANSION_BOARD_TYPE=Tipo de placa de expansion: {label}
LBL_FRAM_NO_RESPONSE=Sin respuesta - la placa no ejecuta esta version de firmware, o no esta conectada.
LOG_QUERIED_0X190_NO_RESPONSE=Consultado 0x190 - sin respuesta 0x191.
LBL_FRAM_NO_VALID_STATE=No hay estado guardado valido (F-RAM sin inicializar, o nada guardado todavia).
LOG_FRAM_STATE_NOTHING_SAVED=Estado de F-RAM: nada valido guardado.
LBL_FRAM_STATE_TEXT=Ultimo guardado bajo: {tool}\nConsigna de temperatura: {temp}°C  |  Velocidad/potencia: {speed}  |  Direccion/enclavamiento: {dir_or_interlock}  |  Ventilador: {fan}\nError critico activo en el ultimo guardado: {had_error}
LOG_FRAM_STATE_FULL=Estado de F-RAM: herramienta={tool}, temp={temp}, velocidad/potencia={speed}, direccion/enclavamiento={dir_or_interlock}, ventilador={fan}, hubo_error={had_error}
LOG_FRAM_ERASE_NO_CONFIRM=Borrado de F-RAM enviado (0x192) - no llego respuesta de confirmacion.
LOG_FRAM_ERASED_CONFIRMED=F-RAM borrada y confirmada.
LOG_KEEPALIVE_STOPPED=Vigilancia periodica '{name}' detenida: {e}
LOG_SOLDER_SETPOINT_ACTIVE=Soldador: consigna {temp}°C, enviando cada 150ms (la vigilancia del firmware es de 250ms).
LOG_SOLDER_TURNED_OFF=Soldador: apagado (consigna 0 enviada una vez).
TOOL_SOLDERING_IRON_FEEDER_LABEL=Soldador - Alimentador de Estaño
LBL_FEEDER_POSITION=Posición del alimentador (pasos)
VAL_FEEDER_STEPS={n} pasos
TITLE_RESET_FEEDER_POSITION_Q=¿Restablecer posición del alimentador?
CONFIRM_RESET_FEEDER_POSITION=Esto restablece a 0 la posición rastreada del alimentador de estaño - normalmente se hace justo después de cargar un carrete nuevo. ¿Continuar?
LOG_FEEDER_POSITION_RESET=Alimentador de estaño: posición restablecida a 0.
BTN_RESET_FEEDER_POSITION=Restablecer Posición a 0
HELP_FEEDER_POSITION_OPEN_LOOP=Estimación en lazo abierto - este motor no tiene encoder, así que esta es la mejor estimación de la propia placa basada en pasos comandados, no una medición física. Restablécela tras cargar un carrete nuevo para que vuelva a tener sentido.
LOG_TOOL_MOVE={tool}: mover {direction}, {n} pasos.
LOG_AOI_MODE_PERIOD=AOI: modo={mode}, periodo={period}
LBL_ARMED=armado
LBL_SAFE=seguro
LOG_LASER_POWER_INTERLOCK=Laser: potencia {power}, enclavamiento {interlock}, enviando cada 150ms (la vigilancia del firmware es de 250ms).
LOG_LASER_STOPPED=Laser: detenido (potencia 0, enclavamiento seguro enviado una vez).
LOG_SCAN_PROBE_IMPACT=Sonda de escaneo: impacto detectado a las {ts}
LOG_3DP_NOZZLE_SETPOINT_ACTIVE=Boquilla de impresora 3D: consigna {temp}°C, enviando cada 150ms (la vigilancia del firmware es de 250ms, el movimiento del extrusor no tiene vigilancia).
LOG_3DP_NOZZLE_TURNED_OFF=Boquilla de impresora 3D: apagada (consigna 0 enviada una vez).
LOG_LAYER_FAN_ACTIVE=Ventilador de capa: potencia {power}, enviando cada 400ms (la vigilancia del firmware es de 1000ms).
LOG_LAYER_FAN_STOPPED=Ventilador de capa: detenido (potencia 0 enviada una vez).
LOG_DEBUG_BUNDLE_EXPORTED=Paquete de depuracion exportado a {path}

