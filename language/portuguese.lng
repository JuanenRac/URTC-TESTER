QTLOG_ALL_OFF_FAILED=Falha ao desligar tudo
QTLOG_ALL_OFF_SENT=Desligar tudo enviado
QTLOG_AOI_BLOCKED=AOI bloqueado: modo ou período do estroboscópio inválido
