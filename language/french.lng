# URTC Tester - fichier de langue Français
# CLE=Valeur, une par ligne. Les lignes commençant par # et les lignes
# vides sont ignorées. Un \n littéral dans une valeur devient un vrai
# saut de ligne.

LBL_ACTUAL_RPM=RPM réel :
LBL_ANALOG_READING=Lecture analogique (ADC 12 bits) :
BTN_AUTO_DETECT=Détection automatique
LBL_CAN_ID_HEX=ID CAN (hex) :
BTN_CLEAR=Effacer
BTN_CONNECT=Connecter
TAB_CUSTOM_FRAME=Trame CAN personnalisée
LBL_DATA_BYTES_HEX=Octets de données (hex, séparés par des espaces) :
BTN_DISCONNECT=Déconnecter
LBL_ENDSTOP_LIMIT_SWITCH=Fin de course :
BTN_ERASE_FRAM=Effacer la F-RAM...
LBL_EXPANSION_BOARD_TYPE=Type de carte d'extension (voir EXPANSION.TXT) :
BTN_EXPORT_ASC=Exporter .asc...
BTN_EXPORT_TRC=Exporter .trc...
LBL_HOTEND_FAN_RPM=RPM ventilateur hotend :
LBL_HOTEND_TEMPERATURE=Température hotend :
LBL_IMPACTS_DETECTED_SESSION=Impacts détectés cette session :
LBL_LAST_IMPACT=Dernier impact :
LBL_LAYER_FAN_RPM=RPM ventilateur de couche :
LBL_LIVE_TEMPERATURE=Température en direct :
BTN_STOP_MOTION=ARRET
LOG_TOOL_STOP={tool} : ordre d'arret envoye (0 pas).
LOG_DRILL_STOPPED=Perceuse arretee (vitesse 0, frein actif).
LBL_PART_DETECTED_LM393=Pièce détectée (LM393) :
BTN_QUERY_DIAG0=Interroger DIAG0
BTN_QUERY_STATE=Interroger l'état
BTN_QUERY=Interroger
BTN_REFRESH=Actualiser
LBL_REPEAT_EVERY=Répéter toutes les
CHK_RING_ON=Anneau allumé
BTN_RUN_SELF_TEST=Lancer l'autotest...
LBL_SPI_BYTES_TO_SEND=Octets SPI à envoyer (hex, séparés par des espaces) :
TITLE_SCAN_PROBE_TELEMETRY=Sonde de balayage - télémétrie d'événements uniquement (0x095)
BTN_SEND_ONCE=Envoyer une fois
BTN_SEND=Envoyer
HELP_SENDS_RAW_FRAME=Envoie une trame brute - utile pour une commande qui n'a pas encore son propre contrôle dédié ici, ou pour tester quelque chose non (encore) documenté dans CANBUS.TXT. Aucune validation au-delà de la plage d'ID et DLC\u22648 - ce qui est envoyé est exactement ce qui passe sur le bus.
LBL_STATUS_LED_OVERRIDE=Forçage LED d'état (R/V/B) :
TAB_TOOL_CONTROLS=Commandes de l'outil - {name}
TITLE_VACUUM_TELEMETRY=Ventouse de préhension - télémétrie uniquement (0x145)
LBL_MS_UNIT=ms
MSG_RESTART_NEEDED=Redémarrez URTC Tester pour que la nouvelle langue prenne effet.
TITLE_EXPORT_FAILED=Échec de l'exportation
TITLE_RUN_SELF_TEST_Q=Lancer l'autotest ?
MSG_SELF_TEST_CONFIRM=Ceci envoie un petit nombre de commandes sûres, au repos (consigne/vitesse/puissance toutes à 0) pour vérifier que la carte répond comme attendu pour l'outil détecté - rien ici ne chauffe, ne tire ou ne fait tourner quoi que ce soit à une puissance significative. Continuer ?
OPT_STANDARD=Standard
OPT_NIGHT=Nuit
OPT_STANDBY=Veille
OPT_FORWARD=Avant
OPT_REVERSE=Arrière
OPT_CLOCKWISE=Horaire
OPT_COUNTER_CLOCKWISE=Antihoraire
OPT_OFF=Éteint
OPT_SYNCHRONOUS_STROBE=Stroboscope synchrone
OPT_FIXED_CONTINUOUS=Fixe continu
WARN_NO_CARRIER=ATTENTION : {interface} signale l'absence de porteuse - c'est ce que le noyau affiche lors d'une condition de bus-off CAN (trop d'erreurs de transmission) ou d'une liaison tout aussi morte. Si l'adaptateur est alimenté et câblé à un bus actif, essayez : sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=erreur de lecture du bus : {e}
LOG_HANDLER_ERROR=erreur de gestionnaire pour 0x{can_id:03X} : {e}
LOG_SNIFFER_ERROR=erreur de rappel sniffer : {e}
LBL_NO_RESPONSE_SHORT=aucune réponse
LBL_DIAG0_HIGH=HAUT (actif - blocage/erreur sur le driver embarqué ou d'extension)
LBL_DIAG0_LOW=BAS (dégagé)
LBL_EMPTY_PARENS=(vide)
LBL_SPI_NO_RESPONSE=(aucune réponse - la carte n'exécute pas cette version de firmware, ou n'est pas connectée)
LBL_NO_RESPONSE_OLDER_FW=Aucune réponse (firmware plus ancien, ou non connecté)
LBL_FRAM_NO_RESPONSE=Aucune réponse - la carte n'exécute pas cette version de firmware, ou n'est pas connectée.
LBL_FRAM_NO_VALID_STATE=Aucun état enregistré valide (F-RAM non initialisée, ou rien enregistré pour l'instant).
LBL_FRAM_STATE_TEXT=Dernier enregistrement sous : {tool}\nConsigne de température : {temp}°C  |  Vitesse/puissance : {speed}  |  Direction/verrouillage : {dir_or_interlock}  |  Ventilateur : {fan}\nErreur critique active au dernier enregistrement : {had_error}
LBL_FEEDER_POSITION=Position de l'alimentateur (pas)
VAL_FEEDER_STEPS={n} pas
BTN_RESET_FEEDER_POSITION=Réinitialiser la Position à 0
HELP_FEEDER_POSITION_OPEN_LOOP=Estimation en boucle ouverte - ce moteur n'a pas d'encodeur, donc c'est la meilleure estimation de cette carte basée sur les pas commandés, pas une mesure physique. Réinitialisez-la après avoir chargé une bobine neuve pour qu'elle redevienne significative.
LOG_TOOL_MOVE={tool} : déplacement {direction}, {n} pas.
LOG_TOOL_MOVE_BLOCKED_DIRECTION={tool} : déplacement bloqué - direction inconnue {direction!r}.

# --- Barre de menu ---
MENU_SAVE_LOGS=Enregistrer les journaux...
MENU_README=Lisez-moi
MENU_GITHUB=GitHub d'URTC
MENU_LICENSE=Licence
