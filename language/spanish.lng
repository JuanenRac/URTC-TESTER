BTN_EXPORT_ASC=Exportar .asc...
BTN_EXPORT_TRC=Exportar .trc...
BTN_EXPORT_DEBUG_BUNDLE=Exportar paquete de depuracion...
LBL_EXTRUDER_DIRECTION=Direccion del extrusor:
HELP_EXTRUDER_MOTION_SHARED_FRAME=El movimiento del extrusor comparte esta misma trama con la consigna de la boquilla (0x170), pero no esta vigilado por watchdog en si mismo - solo la temperatura lo esta.
LBL_EXTRUDER_STEPS=Pasos del extrusor:
TAB_FRAM=F-RAM
TAB_GLOBAL_CONTROLS=Controles globales
LBL_HEATER_ACTIVE_250MS=Calentador activo (vigilancia de 250ms)
LBL_HOTEND_FAN_RPM=RPM del ventilador del hotend:
LBL_HOTEND_FAN_POWER=Potencia del ventilador del hotend (0-255):
LBL_HOTEND_TEMPERATURE=Temperatura del hotend:
LBL_ID_PINS=Pines de ID:
LBL_IMPACTS_DETECTED_SESSION=Impactos detectados esta sesion:
HELP_AOI_RING_IGNORED=En modo Inspeccion AOI, el encendido/apagado del anillo aqui se ignora - usa el propio control de modo de anillo de esa herramienta (0x150 cubre encendido/apagado/estrobo ahi). El color se sigue aplicando.
LBL_INTERLOCK_ARMED=Enclavamiento armado (necesario para que cualquier potencia > 0 tenga efecto)
HELP_INTERLOCK_MUST_BE_ARMED=El enclavamiento debe armarse explicitamente abajo - esto es un laser real.
LBL_LAST_IMPACT=Ultimo impacto:
LBL_LAYER_FAN_RPM=RPM del ventilador de capa:
LBL_LAYER_FAN_POWER=Potencia del ventilador de capa (0-255):
LBL_LIVE_TEMPERATURE=Temperatura en vivo:
TITLE_LOG=Registro
BTN_MOVE_EXTRUDER_ONCE=Mover extrusor una vez
BTN_MOVE=Mover
HELP_NO_WATCHDOG_STALL_DETECTOR=Este ventilador no tiene vigilancia de comunicacion - esta protegido por un detector de bloqueo en su lugar (0 RPM durante 3s tras arrancar = Error Critico), ya que perder este ventilador importa incluso si el maestro se queda callado brevemente.
STATUS_NO_RESPONSE_CHECK_WIRING=Sin respuesta - revisa cableado/alimentacion/velocidad de bus
STATUS_NO_RESPONSE_ANY_BITRATE=Sin respuesta a ninguna velocidad de bus estandar
STATUS_NO_RESPONSE_0X110=Sin respuesta a 0x110 - ¿el firmware de esta placa es lo bastante reciente como para soportarlo?
HELP_NO_WATCHDOG_HOLDS_VALUE=Este comando no tiene vigilancia - se mantiene hasta que se envia un nuevo valor, 0 de velocidad activa el freno.
STATUS_NOT_CONNECTED=No conectado
LBL_NOZZLE_SETPOINT=Consigna de la boquilla (\u00b0C, 0-300):
LBL_OLED_MODE=Modo OLED:
HELP_ONE_SHOT_NO_TELEMETRY=Comando de un solo disparo, sin telemetria de esta herramienta - el firmware activa el driver al recibir esta trama y corta la potencia cuando termina el movimiento.
BTN_OPEN_BUS_MONITOR=Abrir monitor de bus en bruto...
LBL_PART_DETECTED_LM393=Pieza detectada (LM393):
BTN_PAUSE=Pausar
LBL_PERSISTENCE_FRAM=F-RAM de persistencia (FM24CL64B, comparte I2C2 con el OLED):
LBL_POWER_0_255=Potencia (0-255):
BTN_QUERY_DIAG0=Consultar DIAG0
BTN_QUERY_STATE=Consultar estado
BTN_QUERY=Consultar
HELP_READONLY_SET_VIA_FLASHER=Solo lectura aqui - se configura desde la seccion CAN OTA del URTC Flasher, ya que es un paso de configuracion de hardware que se hace una sola vez junto con una actualizacion de firmware, no algo que se cambie desde esta herramienta.
BTN_REFRESH=Actualizar
LBL_REPEAT_EVERY=Repetir cada
LBL_RESPONSE=Respuesta:
LBL_RING_LED_RGB=LED de anillo (R/G/B):
HELP_RING_COLOR_FROM_GLOBAL=El color del anillo viene del panel de Controles globales de arriba (0x100) - esto solo controla el temporizado de encendido/apagado/estrobo, no el color en si.
LBL_RING_MODE=Modo de anillo:
CHK_RING_ON=Anillo encendido
BTN_RUN_SELF_TEST=Ejecutar autoprueba...
LBL_SPI_BYTES_TO_SEND=Bytes SPI a enviar (hex, separados por espacio):
TITLE_SCAN_PROBE_TELEMETRY=Sonda de escaneo - solo telemetria de eventos (0x095)
BTN_SEND_ONCE=Enviar una vez
BTN_SEND=Enviar
HELP_SENDS_RAW_FRAME=Envia una trama en bruto - util para un comando que aun no tiene su propio control dedicado aqui, o para probar algo no documentado (o no documentado todavia) en CANBUS.TXT. Sin validacion mas alla del rango de ID y DLC\u22648 - lo que se envia es exactamente lo que sale al bus.
HELP_SCAN_PROBE_INTERRUPT=Enviado directamente desde la interrupcion de contacto en el nivel mas bajo (mayor prioridad) de ID CAN de todo el bus, saltandose cualquier planificador - por diseño, esto deberia llegar practicamente al instante en cada contacto.
RADIO_SERIAL_SLCAN=Serie / SLCAN
LBL_SETPOINT_TEMPERATURE=Consigna de temperatura (\u00b0C, 0-450):
HELP_SHOWS_EVERY_FRAME=Muestra cada trama vista, cualquier ID - independiente del panel de herramienta activo.
RADIO_SOCKETCAN_NATIVE=SocketCAN (nativo)
LBL_SPEED_0_255=Velocidad (0-255):
LBL_STATUS_LED_OVERRIDE=Anulacion del LED de estado (R/G/B):
LBL_STEPS=Pasos:
LBL_STROBE_PERIOD=Periodo de estrobo:
LBL_TOOL_NUMBER=Herramienta #:
TAB_TOOL_CONTROLS=Controles de herramienta
LBL_TRANSPORT=Transporte:
STATUS_TRYING_EACH_BITRATE=Probando cada velocidad de bus...
HELP_UP_TO_7_BYTES_SPI=Hasta 7 bytes por transferencia (CS mantenido bajo durante toda la operacion) - coincide con lo que puede llevar una sola trama 0x180 (1 byte de longitud + hasta 7 bytes de datos).
TITLE_VACUUM_TELEMETRY=Ventosa de vacio - solo telemetria (0x145)
LBL_MS_UNIT=ms
LBL_CAN_INTERFACE=Interfaz CAN:
HELP_SOCKETCAN_BITRATE_OS_LEVEL=La velocidad de bus de SocketCAN se configura a nivel del sistema operativo (ip link), no aqui
