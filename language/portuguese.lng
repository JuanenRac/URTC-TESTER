# URTC Tester - ficheiro de idioma Português
# CHAVE=Valor, um por linha. As linhas que começam por # e as linhas
# em branco são ignoradas. Um \n literal dentro de um valor é convertido
# numa quebra de linha real.

STATUS_CONNECT_TO_CHECK=(liga para verificar)
STATUS_CONNECT_TO_DETECT=(liga para detetar)
STATUS_NO_RESPONSE_SHORT=(sem resposta)
LBL_ACTIVE_1000MS_WATCHDOG=Ativo (watchdog de 1000ms)
LBL_ACTIVE_250MS_WATCHDOG=Ativo (reenvio automático para satisfazer o watchdog de 250ms)
LBL_ACTIVE_TOOL=Ferramenta ativa:
LBL_ACTUAL_RPM=RPM real:
LBL_ANALOG_READING=Leitura analógica (ADC de 12 bits):
BTN_AUTO_DETECT=Autodeteção
LBL_BITRATE=Velocidade do barramento:
LBL_BOARD_STATE=Estado da placa:
LBL_CAN_ID_HEX=ID CAN (hex):
LBL_COM_PORT=Porta COM:
BTN_CLEAR=Limpar
LBL_CONNECT_AND_DETECT_PROMPT=Liga e deteta a ferramenta ativa para ver aqui os respetivos controlos.
TAB_CONNECT_TITLE=Ligar ao adaptador USB-CAN
BTN_CONNECT=Ligar
TAB_CUSTOM_FRAME=Trama CAN personalizada
LBL_DATA_BYTES_HEX=Bytes de dados (hex, separados por espaço):
BTN_DETECT=Detetar
STATUS_DETECTING=A detetar...
LBL_DIRECTION=Direção:
BTN_DISCONNECT=Desligar
LBL_ENDSTOP_LIMIT_SWITCH=Fim de curso:
BTN_ERASE_FRAM=Apagar F-RAM...
TAB_EXPANSION_BOARD=Placa de expansão
LBL_EXPANSION_BOARD_TYPE=Tipo de placa de expansão (ver EXPANSION.TXT):
BTN_EXPORT_ASC=Exportar .asc...
BTN_EXPORT_TRC=Exportar .trc...
BTN_EXPORT_DEBUG_BUNDLE=Exportar pacote de depuração...
LBL_EXTRUDER_DIRECTION=Direção do extrusor:
HELP_EXTRUDER_MOTION_SHARED_FRAME=O movimento do extrusor partilha a trama do valor de referência do bico (0x170). Enquanto o aquecedor é mantido, o seu refrescamento de 150 ms envia 0 passos, que o firmware lê como ordem de paragem, pelo que um movimento iniciado agora é cancelado em 150 ms. Mova o extrusor com o aquecedor desligado.
LBL_EXTRUDER_STEPS=Passos do extrusor:
TAB_FRAM=F-RAM
TAB_GLOBAL_CONTROLS=Controlos globais
LBL_HEATER_ACTIVE_250MS=Aquecedor ativo (watchdog de 250ms)
LBL_HOTEND_FAN_RPM=RPM da ventoinha do hotend:
LBL_HOTEND_FAN_POWER=Potência da ventoinha do hotend (0-255):
LBL_HOTEND_TEMPERATURE=Temperatura do hotend:
LBL_ID_PINS=Pinos de ID:
LBL_IMPACTS_DETECTED_SESSION=Impactos detetados nesta sessão:
HELP_AOI_RING_IGNORED=No modo de Inspeção AOI, o ligar/desligar do anel aqui é ignorado - usa o controlo do modo de anel da própria ferramenta (o 0x150 cobre ligado/desligado/estroboscópio aí). A cor continua a ser aplicada.
LBL_INTERLOCK_ARMED=Interbloqueio armado (necessário para que qualquer potência > 0 tenha efeito)
HELP_INTERLOCK_MUST_BE_ARMED=O interbloqueio tem de ser armado explicitamente abaixo - isto é um laser real.
LBL_LAST_IMPACT=Último impacto:
LBL_LAYER_FAN_RPM=RPM da ventoinha de camada:
LBL_LAYER_FAN_POWER=Potência da ventoinha de camada (0-255):
LBL_LIVE_TEMPERATURE=Temperatura em direto:
TITLE_LOG=Registo
BTN_MOVE_EXTRUDER_ONCE=Mover extrusor uma vez
BTN_MOVE=Mover
BTN_STOP_MOTION=PARAR
LOG_TOOL_STOP={tool}: ordem de paragem enviada (0 passos).
HELP_NO_WATCHDOG_STALL_DETECTOR=Esta ventoinha não tem watchdog de comunicação - está protegida por um detetor de bloqueio (0 RPM durante 3s após o arranque = Erro Crítico), pois perder esta ventoinha importa mesmo que o mestre fique brevemente em silêncio.
STATUS_NO_RESPONSE_CHECK_WIRING=Sem resposta - verifica a cablagem/alimentação/velocidade do barramento
STATUS_NO_RESPONSE_ANY_BITRATE=Sem resposta a qualquer velocidade de barramento padrão
STATUS_NO_RESPONSE_0X110=Sem resposta a 0x110 - o firmware desta placa é suficientemente recente para o suportar?
HELP_NO_WATCHDOG_HOLDS_VALUE=O berbequim tem um watchdog de 250 ms: marca Ativo e a velocidade é reenviada automaticamente; ao desmarcar é enviada velocidade 0 (travão ativo). Sem isso a placa para o berbequim e declara um erro crítico.
LOG_DRILL_STOPPED=Berbequim parado (velocidade 0, travão ativo).
STATUS_NOT_CONNECTED=Não ligado
LBL_NOZZLE_SETPOINT=Valor pretendido do bico (\u00b0C, 0-300):
LBL_OLED_MODE=Modo OLED:
HELP_ONE_SHOT_NO_TELEMETRY=Comando de disparo único, sem telemetria desta ferramenta - o firmware ativa o driver ao receber esta trama e corta a potência quando o movimento termina.
BTN_OPEN_BUS_MONITOR=Abrir monitor de barramento em bruto...
LBL_PART_DETECTED_LM393=Peça detetada (LM393):
BTN_PAUSE=Pausar
LBL_PERSISTENCE_FRAM=F-RAM de persistência (FM24CL64B, partilha o I2C2 com o OLED):
LBL_POWER_0_255=Potência (0-255):
BTN_QUERY_DIAG0=Consultar DIAG0
BTN_QUERY_STATE=Consultar estado
BTN_QUERY=Consultar
HELP_READONLY_SET_VIA_FLASHER=Apenas leitura aqui - configura-se a partir da secção CAN OTA do URTC Flasher, pois é um passo de configuração de hardware feito uma única vez juntamente com uma atualização de firmware, e não algo que se altere a partir desta ferramenta.
BTN_REFRESH=Atualizar
LBL_REPEAT_EVERY=Repetir a cada
LBL_RESPONSE=Resposta:
LBL_RING_LED_RGB=LED do anel (R/G/B):
HELP_RING_COLOR_FROM_GLOBAL=A cor do anel vem do painel de Controlos globais acima (0x100) - isto controla apenas a temporização de ligado/desligado/estroboscópio, não a cor em si.
LBL_RING_MODE=Modo do anel:
CHK_RING_ON=Anel ligado
BTN_RUN_SELF_TEST=Executar autoteste...
LBL_SPI_BYTES_TO_SEND=Bytes SPI a enviar (hex, separados por espaço):
TITLE_SCAN_PROBE_TELEMETRY=Sonda de varrimento - apenas telemetria de eventos (0x095)
BTN_SEND_ONCE=Enviar uma vez
BTN_SEND=Enviar
HELP_SENDS_RAW_FRAME=Envia uma trama em bruto - útil para um comando que ainda não tem o seu próprio controlo dedicado aqui, ou para testar algo não documentado (ou ainda não documentado) em CANBUS.TXT. Sem validação além do intervalo de ID e DLC\u22648 - o que é enviado é exatamente o que sai para o barramento.
HELP_SCAN_PROBE_INTERRUPT=Enviado diretamente a partir da interrupção de contacto no nível mais baixo (maior prioridade) de ID CAN de todo o barramento, contornando qualquer escalonador - por conceção, isto deve chegar praticamente de imediato em cada contacto.
RADIO_SERIAL_SLCAN=Série / SLCAN
LBL_SETPOINT_TEMPERATURE=Valor pretendido de temperatura (\u00b0C, 0-445):
HELP_SHOWS_EVERY_FRAME=Mostra todas as tramas vistas, qualquer ID - independente do painel da ferramenta ativa.
RADIO_SOCKETCAN_NATIVE=SocketCAN (nativo)
LBL_SPEED_0_255=Velocidade (0-255):
LBL_STATUS_LED_OVERRIDE=Substituição do LED de estado (R/G/B):
LBL_STEPS=Passos:
LBL_STROBE_PERIOD=Período do estroboscópio (ms):
LBL_TOOL_NUMBER=Ferramenta #:
TAB_TOOL_CONTROLS=Controlos da ferramenta - {name}
LBL_TRANSPORT=Transporte:
STATUS_TRYING_EACH_BITRATE=A testar cada velocidade do barramento...
HELP_UP_TO_7_BYTES_SPI=Até 7 bytes por transferência (CS mantido em baixo durante toda a operação) - corresponde ao que uma única trama 0x180 pode transportar (1 byte de comprimento + até 7 bytes de dados).
TITLE_VACUUM_TELEMETRY=Ventosa de vácuo - apenas telemetria (0x145)
LBL_MS_UNIT=ms
LBL_CAN_INTERFACE=Interface CAN:
HELP_SOCKETCAN_BITRATE_OS_LEVEL=A velocidade do barramento SocketCAN é configurada ao nível do sistema operativo (ip link), não aqui
COL_TIME=Hora
COL_ID=ID
COL_DLC=DLC
COL_DATA_HEX=Dados (hex)
COL_DT_MS=Δt (ms)
TITLE_RESTART_NEEDED=Reinício necessário
MSG_RESTART_NEEDED=Reinicia o URTC Tester para que o novo idioma tenha efeito.
TITLE_COULDNT_SAVE=Não foi possível guardar
MSG_LANGUAGE_NOT_SAVED=A preferência de idioma não foi guardada - verifica se {path} tem permissões de escrita.
TITLE_NOT_CONNECTED=Não ligado
MSG_CONNECT_FIRST=Liga primeiro ao adaptador.
TITLE_BAD_INPUT=Entrada incorreta
TITLE_EXPORT_FAILED=Falha ao exportar
TITLE_NOTHING_SELECTED=Nada selecionado
MSG_SELECT_PORT_FIRST=Seleciona primeiro uma porta/interface.
TITLE_CONNECTION_FAILED=Falha de ligação
TITLE_ALREADY_CONNECTED=Já ligado
MSG_DISCONNECT_FIRST_AUTODETECT=Desliga primeiro e depois faz a autodeteção antes de voltares a ligar.
MSG_SELECT_COM_PORT_FIRST=Seleciona primeiro uma porta COM.
TITLE_NOT_DETECTED=Não detetado
MSG_RUN_DETECT_FIRST=Executa primeiro Detetar, para saberes que ferramenta testar.
TITLE_NOTHING_TO_EXPORT=Nada para exportar
MSG_TABLE_IS_EMPTY=A tabela está vazia.
TITLE_NO_CONFIRMATION=Sem confirmação
MSG_ERASE_NO_RESPONSE=Comando de apagamento enviado, mas não chegou nenhuma resposta a confirmá-lo.
TITLE_ERASED=Apagado
MSG_FRAM_ERASED_CONFIRMED=F-RAM apagada e confirmada pela placa.
TITLE_DEBUG_BUNDLE_SAVED=Pacote de depuração guardado
MSG_SAVED_TO=Guardado em:\n{path}
TITLE_CONNECTION_FAILED_PERMISSION=Falha de ligação - permissão negada
MSG_PERMISSION_DENIED_HELP={msg}\n\nNo Linux, os dispositivos série normalmente precisam que o teu utilizador esteja no grupo 'dialout':\n\n    sudo usermod -a -G dialout $USER\n\nDepois termina a sessão e inicia-a de novo (os grupos são lidos ao iniciar sessão) e tenta outra vez.
TITLE_PYSERIAL_NOT_INSTALLED=pyserial não está instalado
MSG_PYSERIAL_NEEDED_AUTODETECT=A autodeteção precisa do pyserial para ligações série/SLCAN.\n\nInstala-o com: pip install pyserial
TITLE_RUN_SELF_TEST_Q=Executar autoteste?
MSG_SELF_TEST_CONFIRM=Isto envia um pequeno número de comandos seguros em repouso (valor pretendido/velocidade/potência todos a 0) para verificar que a placa responde como esperado para a ferramenta detetada - nada aqui aquece, dispara ou roda nada a potência real. Continuar?
TITLE_ERASE_FRAM_Q=Apagar F-RAM?
MSG_ERASE_FRAM_CONFIRM=Isto apaga permanentemente o estado de parâmetros guardado na F-RAM de persistência da placa. Isto não pode ser desfeito. Continuar?
TITLE_PLAIN_STEPPER_MOTION={tool} - movimento simples de motor de passo (0x120)
OPT_STANDARD=Padrão
OPT_NIGHT=Noite
OPT_STANDBY=Espera
OPT_FORWARD=Avançar
OPT_REVERSE=Recuar
OPT_CLOCKWISE=Horário
OPT_COUNTER_CLOCKWISE=Anti-horário
OPT_OFF=Desligado
OPT_SYNCHRONOUS_STROBE=Estroboscópio sincronizado
OPT_FIXED_CONTINUOUS=Fixo contínuo
OPT_RETRACT=Retrair
WARN_NO_CARRIER=AVISO: {interface} reporta sem portadora - é o que o kernel mostra durante uma condição de bus-off do CAN (demasiados erros de transmissão) ou uma ligação igualmente em baixo. Se o adaptador está ligado e cablado a um barramento ativo, experimenta: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=erro de leitura do barramento: {e}
LOG_HANDLER_ERROR=erro de manipulador para 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=erro de callback do sniffer: {e}
LOG_TESTER_READY=URTC Tester pronto. HardwareID esperado: 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=A aguardar o adaptador em modo SLCAN - consulta o README se o teu CANable aparecer como algo diferente de uma porta série.
LOG_EXPECTING_SOCKETCAN_MODE=Modo SocketCAN - espera-se que a interface já esteja ativa a 500 kbit/s (ip link set ... up type can bitrate 500000). Consulta a secção de Linux do README.
LOG_CONNECTED_TO_PORT=Ligado a {port}, canal CAN aberto
LOG_AT_BITRATE_SUFFIX= a {bitrate}.
LOG_DISCONNECTED=Desligado.
LOG_AUTODETECT_TRYING=Autodeteção: a testar {label}...
LOG_AUTODETECT_RESPONDED=Autodeteção: a placa respondeu a {label}.
LOG_AUTODETECT_NO_RESPONSE=Autodeteção: sem resposta a qualquer velocidade de barramento padrão - verifica a cablagem/alimentação, ou a placa pode estar a usar uma velocidade não padrão que isto não consegue testar.
LOG_QUERYING_ACTIVE_TOOL=A consultar a ferramenta ativa (0x110)...
LOG_QUERYING_VERSION=A consultar a versão (0x7F8)...
LOG_DETECT_FAILED=Deteção falhada: {e} - a ligação pode ter sido fechada enquanto isto decorria.
LOG_DETECTION_FAILED=Deteção falhada: sem resposta a nenhuma das duas consultas.
LOG_ACTIVE_TOOL_STATE=Ferramenta ativa: {name} (ID {tool_id}). Estado: {state}.
LOG_NO_RESPONSE_0X110_HELP=Sem resposta à consulta da ferramenta ativa (0x110/0x111) - isto precisa de firmware compilado com esse suporte; o firmware antigo não responderá.
LOG_VERSION_INFO=Versão: {role}, HardwareID 0x{hw_id:08X}{hw_note}, firmware v{major}.{minor}
LOG_OFF_COMMAND_FAILED_ID=Não foi possível enviar o comando de desligar 0x{cmd_id:03X} ao mudar da ferramenta {tool_id}: {e}
LOG_OFF_COMMAND_FAILED=Não foi possível enviar o comando de desligar ao mudar da ferramenta {tool_id}: {e}
LOG_SENT_GLOBAL_STATUS=Enviado 0x100: RGB de estado=({r1},{g1},{b1}), noite={night}, RGB do anel=({r2},{g2},{b2}), anel_ligado={ring_on}
LOG_EXPORTED_FRAMES=Exportadas {n} tramas para {path}
LOG_QUERIED_0X182_NO_RESPONSE=Consultado 0x182 - sem resposta 0x183.
LOG_EXP_TMC_DIAG0_LEVEL=Nível TMC_DIAG0: {level}
LBL_NO_RESPONSE_SHORT=sem resposta
LBL_DIAG0_HIGH=ALTO (ativo - falha/paragem no driver integrado ou de expansão)
LBL_DIAG0_LOW=BAIXO (limpo)
LBL_EMPTY_PARENS=(vazio)
LOG_SENT_CUSTOM_FRAME=Trama personalizada enviada: ID=0x{can_id:03X}, dados={data}
LOG_REPEATING_CUSTOM_FRAME=A repetir trama personalizada a cada {interval}ms: ID=0x{can_id:03X}, dados={data}
LOG_CUSTOM_PERIODIC_SKIPPING=Trama periódica personalizada: a saltar ciclos até o campo voltar a ser válido ({e})
LOG_CUSTOM_PERIODIC_RESUMING=Trama periódica personalizada: o campo voltou a ser válido, a retomar os envios.
MSG_ENTER_HEX_BYTES_EXAMPLE=Introduz bytes hexadecimais separados por espaço, ex. 01 02 03
MSG_ENTER_1_TO_7_BYTES=Introduz entre 1 e 7 bytes.
LBL_SPI_NO_RESPONSE=(sem resposta - a placa não executa esta versão de firmware, ou não está ligada)
LOG_SENT_0X180_NO_RESPONSE=Enviado 0x180 ({tx}) - sem resposta 0x181.
LBL_SPI_MALFORMED=(mal formado: declarou {n} bytes, mas só chegaram {actual})
LOG_SENT_0X180_MALFORMED=Enviado 0x180 ({tx}) - a resposta 0x181 declarou {n} bytes mas só chegaram {actual}: {rx}
LOG_SENT_0X180_RECEIVED=Enviado 0x180 ({tx}), recebido de volta: {rx}
LBL_NO_RESPONSE_OLDER_FW=Sem resposta (firmware antigo, ou não ligado)
LOG_QUERIED_0X1A1_NO_RESPONSE=Consultado 0x1A1 - sem resposta válida.
LOG_EXPANSION_BOARD_TYPE=Tipo de placa de expansão: {label}
LBL_FRAM_NO_RESPONSE=Sem resposta - a placa não executa esta versão de firmware, ou não está ligada.
LOG_QUERIED_0X190_NO_RESPONSE=Consultado 0x190 - sem resposta 0x191.
LBL_FRAM_NO_VALID_STATE=Não existe estado guardado válido (F-RAM não inicializada, ou ainda nada guardado).
LOG_FRAM_STATE_NOTHING_SAVED=Estado da F-RAM: nada válido guardado.
LBL_FRAM_STATE_TEXT=Último guardado em: {tool}\nValor pretendido de temperatura: {temp}°C  |  Velocidade/potência: {speed}  |  Direção/interbloqueio: {dir_or_interlock}  |  Ventoinha: {fan}\nErro crítico ativo no último guardado: {had_error}
LOG_FRAM_STATE_FULL=Estado da F-RAM: ferramenta={tool}, temp={temp}, velocidade/potência={speed}, direção/interbloqueio={dir_or_interlock}, ventoinha={fan}, teve_erro={had_error}
LOG_FRAM_ERASE_NO_CONFIRM=Apagamento da F-RAM enviado (0x192) - não chegou resposta de confirmação.
LOG_FRAM_ERASED_CONFIRMED=F-RAM apagada e confirmada.
LOG_KEEPALIVE_STOPPED=Watchdog periódico '{name}' parado: {e}
LOG_SOLDER_SETPOINT_ACTIVE=Ferro de soldar: valor pretendido {temp}°C, a enviar a cada 150ms (o watchdog do firmware é de 250ms).
LOG_SOLDER_TURNED_OFF=Ferro de soldar: desligado (valor pretendido 0 enviado uma vez).
TOOL_SOLDERING_IRON_FEEDER_LABEL=Ferro de soldar - Alimentador de Estanho
LBL_FEEDER_POSITION=Posição do alimentador (passos)
VAL_FEEDER_STEPS={n} passos
TITLE_RESET_FEEDER_POSITION_Q=Repor a posição do alimentador?
CONFIRM_RESET_FEEDER_POSITION=Isto repõe a 0 a posição registada do alimentador de estanho - normalmente faz-se logo após carregar uma bobina nova. Continuar?
LOG_FEEDER_POSITION_RESET=Alimentador de estanho: posição reposta a 0.
BTN_RESET_FEEDER_POSITION=Repor Posição a 0
HELP_FEEDER_POSITION_OPEN_LOOP=Estimativa em malha aberta - este motor não tem encoder, por isso esta é a melhor estimativa da própria placa com base nos passos comandados, não uma medição física. Repõe-na depois de carregar uma bobina nova para voltar a fazer sentido.
LOG_TOOL_MOVE={tool}: mover {direction}, {n} passos.
LOG_TOOL_MOVE_BLOCKED_DIRECTION={tool}: movimento bloqueado - direção desconhecida {direction!r}.
LOG_AOI_MODE_PERIOD=AOI: modo={mode}, período={period}
LBL_ARMED=armado
LBL_SAFE=seguro
LOG_LASER_POWER_INTERLOCK=Laser: potência {power}, interbloqueio {interlock}, a enviar a cada 150ms (o watchdog do firmware é de 250ms).
LOG_LASER_STOPPED=Laser: parado (potência 0, interbloqueio seguro enviado uma vez).
LOG_SCAN_PROBE_IMPACT=Sonda de varrimento: impacto detetado às {ts}
LOG_3DP_NOZZLE_SETPOINT_ACTIVE=Bico da impressora 3D: valor de referência {temp}°C, envio a cada 150 ms (o watchdog do firmware é de 250 ms). Cada refrescamento leva 0 passos de extrusor, o que pára qualquer movimento do extrusor em curso.
LOG_3DP_NOZZLE_TURNED_OFF=Bico de impressora 3D: desligado (valor pretendido 0 enviado uma vez).
LOG_LAYER_FAN_ACTIVE=Ventoinha de camada: potência {power}, a enviar a cada 400ms (o watchdog do firmware é de 1000ms).
LOG_LAYER_FAN_STOPPED=Ventoinha de camada: parada (potência 0 enviada uma vez).
LOG_DEBUG_BUNDLE_EXPORTED=Pacote de depuração exportado para {path}

